# Secrets — must never enter the image
.env
.env.*
*.env

# Git
.git
.gitignore
.github

# Dev tooling
node_modules
.npm
.yarn

# Test artifacts
tests/
test-results/
*.test.js
*.spec.js

# Large data directories — mounted as volumes at runtime
schemas/
logs/
uploads/

# Installer (not part of the app image) — dist/assets/web/test hold real
# build output, kept excluded; the one guide doc is re-included below.
installer/
dist/

# Docs and non-runtime files
*.md
connectivity/
*.txt
# architecture/*.md, docs/*.md, installer/ONE_CLICK_INSTALLER_GUIDE.md, and
# SYSTEM_DOCUMENTATION.md ARE read at runtime by
# services/ai/knowledge_ingestion.go's IngestAppDocs (AI knowledge-base
# ingestion) — re-included here despite the blanket *.md/installer/ rules
# above. These were previously fully excluded, meaning that ingestion path
# was a silent no-op in any deployment relying on the built image rather than
# a bind mount (see the Dockerfile's "COPY architecture/" step, added for the
# same reason — docs/, installer/, and SYSTEM_DOCUMENTATION.md have matching
# COPY lines there too now).
!architecture/**/*.md
!architecture/**/*.json
!docs/**/*.md
!installer/ONE_CLICK_INSTALLER_GUIDE.md
!SYSTEM_DOCUMENTATION.md
*.log
*.docx
*.png
*.jpg

# OS and editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Build artifacts
build.log
*.tar.gz
*.zip
