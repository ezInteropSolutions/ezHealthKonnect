# Secrets — must never enter the image
.env
.env.*
*.env

# Git
.git
.gitignore
.github

# Dev tooling
node_modules
.npm
.yarn

# Test artifacts
tests/
test-results/
*.test.js
*.spec.js

# Large data directories — mounted as volumes at runtime
schemas/
logs/
uploads/

# Installer (not part of the app image)
installer/
dist/

# Docs and non-runtime files
*.md
docs/
connectivity/
*.txt
# architecture/*.md IS read at runtime by services/ai/knowledge_ingestion.go's
# IngestAppDocs (AI knowledge-base ingestion) — re-include it despite the
# blanket *.md rule above. This directory was previously fully excluded here,
# meaning that ingestion path was a silent no-op in any deployment relying on
# the built image rather than a bind mount (see the Dockerfile's
# "COPY architecture/" step, added for the same reason).
!architecture/**/*.md
!architecture/**/*.json
*.log
*.docx
*.png
*.jpg

# OS and editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Build artifacts
build.log
*.tar.gz
*.zip
