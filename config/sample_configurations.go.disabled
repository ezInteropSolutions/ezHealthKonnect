// sample_configurations.go
// Sample configurations that use existing wizard mappings and demonstrate all layer types

package config

import (
	"fmt"
	"time"

	"ezhealthkonnect/services"

	"github.com/google/uuid"
)

// CreateSampleConfigurations creates a set of sample configurations for different use cases
func CreateSampleConfigurations() []*services.InterfaceConfig {
	return []*services.InterfaceConfig{
		CreateHL7ADTToFHIRConfig(),
		CreateHL7ORUToFHIRConfig(),
		CreateMLLPToFHIRAPIConfig(),
		CreateFileToQueueConfig(),
		CreateAdvancedRoutingConfig(),
		CreateHighVolumeConfig(),
		CreateSecureMLLPConfig(),
		CreateBusinessRulesConfig(),
	}
}

// CreateHL7ADTToFHIRConfig creates a sample configuration for HL7 ADT to FHIR transformation
func CreateHL7ADTToFHIRConfig() *services.InterfaceConfig {
	interfaceID := uuid.New().String()

	return &services.InterfaceConfig{
		InterfaceID: interfaceID,
		Name:        "HL7 ADT to FHIR - Emergency Department",
		Description: "Processes ADT messages from Emergency Department and transforms to FHIR Patient resources",
		Version:     "1.0.0",
		Status:      "active",
		CreatedAt:   time.Now(),
		UpdatedAt:   time.Now(),
		CreatedBy:   "system",
		UpdatedBy:   "system",

		Pipeline: services.PipelineConfig{
			Input: services.InputConfig{
				Type: "mllp",
				ConnectorConfig: map[string]interface{}{
					"host":                "0.0.0.0",
					"port":                2575,
					"max_connections":     20,
					"read_timeout_ms":     30000,
					"write_timeout_ms":    10000,
					"acknowledgment_mode": "application_accept",
					"character_set":       "UTF-8",
					"keep_connection":     true,
				},
				Validation: services.InputValidationConfig{
					Enabled: true,
					Rules: []services.ValidationRule{
						{
							RuleType:    "required_field",
							FieldPath:   "MSH.3",
							ErrorAction: "reject",
						},
						{
							RuleType:    "required_field",
							FieldPath:   "MSH.9",
							ErrorAction: "reject",
						},
						{
							RuleType:    "message_type_filter",
							FieldPath:   "MSH.9.1",
							ErrorAction: "reject", // Only accept ADT messages
						},
					},
				},
				Preprocessing: services.PreprocessingConfig{
					Enabled: true,
					Steps: []services.PreprocessingStep{
						{
							Type:   "normalize_encoding",
							Config: map[string]interface{}{"target_encoding": "UTF-8"},
						},
						{
							Type:   "remove_whitespace",
							Config: map[string]interface{}{"trim_segments": true},
						},
					},
				},
			},

			Validation: services.ValidationConfig{
				SchemaValidation: services.SchemaValidationConfig{
					Enabled:    true,
					SchemaType: "hl7",
					StrictMode: false,
				},
				BusinessRules: []services.BusinessRule{
					{
						RuleID:       "patient_id_required",
						Condition:    "PID.3 is not empty",
						Validation:   "required",
						ErrorMessage: "Patient ID is mandatory for ADT messages",
						Severity:     "error",
					},
					{
						RuleID:       "patient_name_required",
						Condition:    "PID.5 is not empty",
						Validation:   "required",
						ErrorMessage: "Patient name is required",
						Severity:     "error",
					},
				},
			},

			Transformation: services.TransformationConfig{
				Engine:          "hl7_to_fhir",
				MappingTemplate: "standard_adt_v4",
				CustomMappings: []services.FieldMapping{
					// Standard wizard mappings for ADT messages
					{
						SourceField: "MSH.3",
						TargetField: "MessageHeader.source.name",
						Transformation: services.TransformationStep{
							Type: "direct",
						},
					},
					{
						SourceField: "MSH.4",
						TargetField: "MessageHeader.source.endpoint",
						Transformation: services.TransformationStep{
							Type: "direct",
						},
					},
					{
						SourceField: "MSH.10",
						TargetField: "MessageHeader.id",
						Transformation: services.TransformationStep{
							Type: "direct",
						},
					},
					{
						SourceField: "PID.3",
						TargetField: "Patient.identifier",
						Transformation: services.TransformationStep{
							Type:   "identifier_formatter",
							Config: map[string]interface{}{
								"system": "http://hospital.local/mrn",
								"use":    "usual",
							},
						},
					},
					{
						SourceField: "PID.5",
						TargetField: "Patient.name",
						Transformation: services.TransformationStep{
							Type:   "name_formatter",
							Config: map[string]interface{}{
								"format": "fhir_humanname",
								"use":    "official",
							},
						},
					},
					{
						SourceField: "PID.7",
						TargetField: "Patient.birthDate",
						Transformation: services.TransformationStep{
							Type:   "date_formatter",
							Config: map[string]interface{}{
								"input_format":  "YYYYMMDD",
								"output_format": "YYYY-MM-DD",
							},
						},
					},
					{
						SourceField: "PID.8",
						TargetField: "Patient.gender",
						Transformation: services.TransformationStep{
							Type: "gender_code_conversion",
							Config: map[string]interface{}{
								"mappings": map[string]string{
									"M": "male",
									"F": "female",
									"O": "other",
									"U": "unknown",
								},
							},
						},
					},
					{
						SourceField: "PID.11",
						TargetField: "Patient.address",
						Transformation: services.TransformationStep{
							Type:   "address_formatter",
							Config: map[string]interface{}{
								"format": "fhir_address",
								"use":    "home",
							},
						},
					},
					{
						SourceField: "PID.13",
						TargetField: "Patient.telecom",
						Transformation: services.TransformationStep{
							Type:   "telecom_formatter",
							Config: map[string]interface{}{
								"system": "phone",
								"use":    "home",
							},
						},
					},
					{
						SourceField: "PV1.2",
						TargetField: "Encounter.class",
						Transformation: services.TransformationStep{
							Type: "encounter_class_conversion",
							Config: map[string]interface{}{
								"mappings": map[string]string{
									"E": "emergency",
									"I": "inpatient",
									"O": "outpatient",
									"A": "ambulatory",
								},
							},
						},
					},
					{
						SourceField: "PV1.3",
						TargetField: "Encounter.location",
						Transformation: services.TransformationStep{
							Type:   "location_formatter",
							Config: map[string]interface{}{
								"format": "fhir_location",
							},
						},
					},
					{
						SourceField: "PV1.44",
						TargetField: "Encounter.period.start",
						Transformation: services.TransformationStep{
							Type:   "datetime_formatter",
							Config: map[string]interface{}{
								"input_format":  "YYYYMMDDHHMMSS",
								"output_format": "YYYY-MM-DDTHH:MM:SSZ",
							},
						},
					},
				},
				PostProcessing: []services.PostProcessingStep{
					{
						Type: "add_metadata",
						Config: map[string]interface{}{
							"source_system":   "ED_System",
							"transformation":  "hl7_adt_to_fhir",
							"processing_time": true,
						},
					},
					{
						Type: "validate_fhir",
						Config: map[string]interface{}{
							"profile": "http://hl7.org/fhir/us/core/StructureDefinition/us-core-patient",
						},
					},
				},
			},

			BusinessLogic: services.BusinessLogicConfig{
				RulesEngine: services.RulesEngineConfig{
					Enabled: true,
					Rules: []services.BusinessLogicRule{
						{
							RuleID:    "duplicate_patient_check",
							Condition: "Patient.identifier[0].value exists",
							Action: map[string]interface{}{
								"type":     "lookup_existing",
								"endpoint": "/fhir/Patient",
								"criteria": "identifier",
							},
						},
						{
							RuleID:    "emergency_alert",
							Condition: "Encounter.class == 'emergency'",
							Action: map[string]interface{}{
								"type":    "notification",
								"target":  "emergency_team",
								"message": "New emergency patient arrival",
							},
						},
					},
				},
			},

			Destinations: []services.DestinationConfig{
				{
					DestinationID: uuid.New().String(),
					Type:          "fhir_api",
					Config: map[string]interface{}{
						"base_url":        "http://localhost:8080/fhir",
						"timeout":         30000,
						"auth_type":       "bearer_token",
						"auth_token":      "${FHIR_API_TOKEN}",
						"batch_size":      1,
						"operation":       "create_or_update",
						"validate_fhir":   true,
					},
					RoutingRules: []services.RoutingRule{
						{
							Condition:    "resourceType == 'Patient'",
							ResourceType: "Patient",
							Operation:    "create_or_update",
						},
						{
							Condition:    "resourceType == 'Encounter'",
							ResourceType: "Encounter",
							Operation:    "create",
						},
					},
					ErrorHandling: services.ErrorHandlingConfig{
						RetryCount:      3,
						RetryDelay:      5000,
						DeadLetterQueue: true,
					},
				},
				{
					DestinationID: uuid.New().String(),
					Type:          "database",
					Config: map[string]interface{}{
						"table_name":       fmt.Sprintf("messages_intf_%s", interfaceID[:8]),
						"include_raw":      true,
						"include_fhir":     true,
						"include_metadata": true,
					},
					ErrorHandling: services.ErrorHandlingConfig{
						RetryCount:      2,
						RetryDelay:      1000,
						DeadLetterQueue: false,
					},
				},
			},
		},

		Monitoring: services.MonitoringConfig{
			MetricsEnabled: true,
			AlertThresholds: map[string]float64{
				"error_rate":         0.02,
				"processing_time_ms": 2000,
				"queue_depth":        50,
			},
			RetentionPolicy: map[string]int{
				"raw_messages":       30,
				"processed_messages": 90,
				"error_logs":         365,
			},
		},
	}
}

// CreateHL7ORUToFHIRConfig creates a sample configuration for HL7 ORU to FHIR transformation
func CreateHL7ORUToFHIRConfig() *services.InterfaceConfig {
	interfaceID := uuid.New().String()

	return &services.InterfaceConfig{
		InterfaceID: interfaceID,
		Name:        "HL7 ORU to FHIR - Laboratory Results",
		Description: "Processes ORU laboratory result messages and transforms to FHIR Observation resources",
		Version:     "1.0.0",
		Status:      "active",
		CreatedAt:   time.Now(),
		UpdatedAt:   time.Now(),
		CreatedBy:   "system",
		UpdatedBy:   "system",

		Pipeline: services.PipelineConfig{
			Input: services.InputConfig{
				Type: "mllp",
				ConnectorConfig: map[string]interface{}{
					"host":            "0.0.0.0",
					"port":            2576,
					"max_connections": 10,
					"read_timeout_ms": 45000,
				},
			},

			Transformation: services.TransformationConfig{
				Engine:          "hl7_to_fhir",
				MappingTemplate: "standard_oru_v4",
				CustomMappings: []services.FieldMapping{
					// Laboratory-specific mappings
					{
						SourceField: "OBR.3",
						TargetField: "DiagnosticReport.identifier",
						Transformation: services.TransformationStep{
							Type: "identifier_formatter",
							Config: map[string]interface{}{
								"system": "http://lab.local/order-id",
							},
						},
					},
					{
						SourceField: "OBR.4",
						TargetField: "DiagnosticReport.code",
						Transformation: services.TransformationStep{
							Type: "code_formatter",
							Config: map[string]interface{}{
								"system": "http://loinc.org",
							},
						},
					},
					{
						SourceField: "OBX.3",
						TargetField: "Observation.code",
						Transformation: services.TransformationStep{
							Type: "code_formatter",
							Config: map[string]interface{}{
								"system": "http://loinc.org",
							},
						},
					},
					{
						SourceField: "OBX.5",
						TargetField: "Observation.valueQuantity",
						Transformation: services.TransformationStep{
							Type: "quantity_formatter",
							Config: map[string]interface{}{
								"parse_numeric": true,
							},
						},
					},
					{
						SourceField: "OBX.6",
						TargetField: "Observation.valueQuantity.unit",
						Transformation: services.TransformationStep{
							Type: "unit_formatter",
							Config: map[string]interface{}{
								"system": "http://unitsofmeasure.org",
							},
						},
					},
					{
						SourceField: "OBX.7",
						TargetField: "Observation.referenceRange",
						Transformation: services.TransformationStep{
							Type: "reference_range_formatter",
						},
					},
					{
						SourceField: "OBX.8",
						TargetField: "Observation.interpretation",
						Transformation: services.TransformationStep{
							Type: "interpretation_formatter",
							Config: map[string]interface{}{
								"system": "http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation",
							},
						},
					},
				},
			},

			Destinations: []services.DestinationConfig{
				{
					DestinationID: uuid.New().String(),
					Type:          "fhir_api",
					Config: map[string]interface{}{
						"base_url": "http://localhost:8080/fhir",
						"timeout":  30000,
					},
					RoutingRules: []services.RoutingRule{
						{
							Condition:    "resourceType == 'DiagnosticReport'",
							ResourceType: "DiagnosticReport",
							Operation:    "create",
						},
						{
							Condition:    "resourceType == 'Observation'",
							ResourceType: "Observation",
							Operation:    "create",
						},
					},
				},
			},
		},

		Monitoring: services.MonitoringConfig{
			MetricsEnabled: true,
			AlertThresholds: map[string]float64{
				"error_rate":         0.01,
				"processing_time_ms": 3000,
			},
		},
	}
}

// CreateMLLPToFHIRAPIConfig creates a high-performance MLLP to FHIR API configuration
func CreateMLLPToFHIRAPIConfig() *services.InterfaceConfig {
	interfaceID := uuid.New().String()

	return &services.InterfaceConfig{
		InterfaceID: interfaceID,
		Name:        "High-Performance MLLP to FHIR API",
		Description: "High-throughput interface for processing MLLP messages to FHIR API with optimized performance",
		Version:     "1.0.0",
		Status:      "active",
		CreatedAt:   time.Now(),
		UpdatedAt:   time.Now(),
		CreatedBy:   "system",
		UpdatedBy:   "system",

		Pipeline: services.PipelineConfig{
			Input: services.InputConfig{
				Type: "mllp",
				ConnectorConfig: map[string]interface{}{
					"host":              "0.0.0.0",
					"port":              2577,
					"max_connections":   100,
					"read_timeout_ms":   20000,
					"write_timeout_ms":  5000,
					"buffer_size":       16384,
					"tcp_nodelay":       true,
					"keep_alive":        true,
				},
				Preprocessing: services.PreprocessingConfig{
					Enabled: true,
					Steps: []services.PreprocessingStep{
						{
							Type: "performance_optimization",
							Config: map[string]interface{}{
								"skip_validation":     false,
								"parallel_parsing":    true,
								"cache_field_access":  true,
							},
						},
					},
				},
			},

			Validation: services.ValidationConfig{
				SchemaValidation: services.SchemaValidationConfig{
					Enabled:    true,
					SchemaType: "hl7",
					StrictMode: false, // For performance
				},
			},

			Transformation: services.TransformationConfig{
				Engine:          "hl7_to_fhir",
				MappingTemplate: "optimized_standard_v4",
				PostProcessing: []services.PostProcessingStep{
					{
						Type: "performance_metrics",
						Config: map[string]interface{}{
							"track_timing": true,
						},
					},
				},
			},

			Destinations: []services.DestinationConfig{
				{
					DestinationID: uuid.New().String(),
					Type:          "fhir_api",
					Config: map[string]interface{}{
						"base_url":           "http://localhost:8080/fhir",
						"timeout":            15000,
						"connection_pool":    20,
						"parallel_uploads":   5,
						"batch_size":         10,
						"retry_strategy":     "exponential_backoff",
					},
					ErrorHandling: services.ErrorHandlingConfig{
						RetryCount:      5,
						RetryDelay:      1000,
						DeadLetterQueue: true,
					},
				},
			},
		},

		Monitoring: services.MonitoringConfig{
			MetricsEnabled: true,
			AlertThresholds: map[string]float64{
				"error_rate":           0.005, // 0.5%
				"processing_time_ms":   1000,
				"throughput_per_second": 100,
				"connection_failures":   5,
			},
		},
	}
}

// CreateFileToQueueConfig creates a file-based input to message queue configuration
func CreateFileToQueueConfig() *services.InterfaceConfig {
	interfaceID := uuid.New().String()

	return &services.InterfaceConfig{
		InterfaceID: interfaceID,
		Name:        "File Processing to Message Queue",
		Description: "Processes HL7 files from directory and sends FHIR resources to message queue",
		Version:     "1.0.0",
		Status:      "active",
		CreatedAt:   time.Now(),
		UpdatedAt:   time.Now(),
		CreatedBy:   "system",
		UpdatedBy:   "system",

		Pipeline: services.PipelineConfig{
			Input: services.InputConfig{
				Type: "file",
				ConnectorConfig: map[string]interface{}{
					"watch_directory":    "/data/hl7/inbound",
					"file_pattern":       "*.hl7",
					"archive_directory":  "/data/hl7/processed",
					"error_directory":    "/data/hl7/errors",
					"poll_interval_ms":   5000,
					"max_file_size_mb":   10,
				},
				Preprocessing: services.PreprocessingConfig{
					Enabled: true,
					Steps: []services.PreprocessingStep{
						{
							Type: "file_validation",
							Config: map[string]interface{}{
								"check_encoding": true,
								"check_format":   true,
							},
						},
					},
				},
			},

			Transformation: services.TransformationConfig{
				Engine:          "hl7_to_fhir",
				MappingTemplate: "standard_adt_v4",
			},

			Destinations: []services.DestinationConfig{
				{
					DestinationID: uuid.New().String(),
					Type:          "queue",
					Config: map[string]interface{}{
						"queue_name":   "fhir_processing",
						"exchange":     "health_data",
						"routing_key":  "fhir.patient",
						"durable":      true,
						"auto_delete":  false,
						"persistent":   true,
					},
					RoutingRules: []services.RoutingRule{
						{
							Condition:    "resourceType == 'Patient'",
							ResourceType: "Patient",
							Operation:    "publish",
						},
						{
							Condition:    "resourceType == 'Encounter'",
							ResourceType: "Encounter",
							Operation:    "publish",
						},
					},
				},
			},
		},

		Monitoring: services.MonitoringConfig{
			MetricsEnabled: true,
			AlertThresholds: map[string]float64{
				"file_processing_errors": 0.02,
				"queue_publish_failures": 0.01,
			},
		},
	}
}

// CreateAdvancedRoutingConfig creates a configuration with complex routing rules
func CreateAdvancedRoutingConfig() *services.InterfaceConfig {
	interfaceID := uuid.New().String()

	return &services.InterfaceConfig{
		InterfaceID: interfaceID,
		Name:        "Advanced Multi-Destination Routing",
		Description: "Complex routing configuration that sends different resource types to different destinations",
		Version:     "1.0.0",
		Status:      "active",
		CreatedAt:   time.Now(),
		UpdatedAt:   time.Now(),
		CreatedBy:   "system",
		UpdatedBy:   "system",

		Pipeline: services.PipelineConfig{
			Input: services.InputConfig{
				Type: "mllp",
				ConnectorConfig: map[string]interface{}{
					"host": "0.0.0.0",
					"port": 2578,
				},
			},

			Transformation: services.TransformationConfig{
				Engine:          "hl7_to_fhir",
				MappingTemplate: "standard_adt_v4",
			},

			BusinessLogic: services.BusinessLogicConfig{
				RulesEngine: services.RulesEngineConfig{
					Enabled: true,
					Rules: []services.BusinessLogicRule{
						{
							RuleID:    "patient_routing",
							Condition: "Patient.address[0].state == 'CA'",
							Action: map[string]interface{}{
								"type":  "set_routing_tag",
								"value": "california_patients",
							},
						},
						{
							RuleID:    "emergency_routing",
							Condition: "Encounter.class == 'emergency'",
							Action: map[string]interface{}{
								"type":  "set_routing_tag",
								"value": "emergency_cases",
							},
						},
					},
				},
			},

			Destinations: []services.DestinationConfig{
				{
					DestinationID: uuid.New().String(),
					Type:          "fhir_api",
					Config: map[string]interface{}{
						"base_url": "http://primary-fhir-server:8080/fhir",
						"timeout":  30000,
					},
					RoutingRules: []services.RoutingRule{
						{
							Condition:    "resourceType == 'Patient' AND routing_tag != 'california_patients'",
							ResourceType: "Patient",
							Operation:    "create_or_update",
						},
					},
				},
				{
					DestinationID: uuid.New().String(),
					Type:          "fhir_api",
					Config: map[string]interface{}{
						"base_url": "http://california-fhir-server:8080/fhir",
						"timeout":  30000,
					},
					RoutingRules: []services.RoutingRule{
						{
							Condition:    "routing_tag == 'california_patients'",
							ResourceType: "Patient",
							Operation:    "create_or_update",
						},
					},
				},
				{
					DestinationID: uuid.New().String(),
					Type:          "queue",
					Config: map[string]interface{}{
						"queue_name": "emergency_alerts",
						"exchange":   "urgent",
					},
					RoutingRules: []services.RoutingRule{
						{
							Condition:    "routing_tag == 'emergency_cases'",
							ResourceType: "Encounter",
							Operation:    "publish",
						},
					},
				},
				{
					DestinationID: uuid.New().String(),
					Type:          "database",
					Config: map[string]interface{}{
						"table_name": fmt.Sprintf("messages_intf_%s", interfaceID[:8]),
					},
					RoutingRules: []services.RoutingRule{
						{
							Condition:    "always",
							ResourceType: "*",
							Operation:    "store",
						},
					},
				},
			},
		},

		Monitoring: services.MonitoringConfig{
			MetricsEnabled: true,
			AlertThresholds: map[string]float64{
				"routing_failures": 0.01,
			},
		},
	}
}

// CreateHighVolumeConfig creates a configuration optimized for high message volume
func CreateHighVolumeConfig() *services.InterfaceConfig {
	interfaceID := uuid.New().String()

	return &services.InterfaceConfig{
		InterfaceID: interfaceID,
		Name:        "High Volume Message Processing",
		Description: "Optimized configuration for processing high volumes of HL7 messages",
		Version:     "1.0.0",
		Status:      "active",
		CreatedAt:   time.Now(),
		UpdatedAt:   time.Now(),
		CreatedBy:   "system",
		UpdatedBy:   "system",

		Pipeline: services.PipelineConfig{
			Input: services.InputConfig{
				Type: "mllp",
				ConnectorConfig: map[string]interface{}{
					"host":              "0.0.0.0",
					"port":              2579,
					"max_connections":   200,
					"read_timeout_ms":   15000,
					"write_timeout_ms":  3000,
					"buffer_size":       32768,
					"tcp_nodelay":       true,
					"tcp_keepalive":     true,
					"worker_threads":    10,
				},
				Preprocessing: services.PreprocessingConfig{
					Enabled: true,
					Steps: []services.PreprocessingStep{
						{
							Type: "high_volume_optimization",
							Config: map[string]interface{}{
								"batch_processing":   true,
								"parallel_parsing":   true,
								"memory_pooling":     true,
								"skip_non_critical":  true,
							},
						},
					},
				},
			},

			Validation: services.ValidationConfig{
				SchemaValidation: services.SchemaValidationConfig{
					Enabled:    true,
					SchemaType: "hl7",
					StrictMode: false, // Relaxed for performance
				},
				BusinessRules: []services.BusinessRule{
					// Minimal business rules for performance
					{
						RuleID:       "critical_fields_only",
						Condition:    "MSH.9 is not empty AND PID.3 is not empty",
						Validation:   "required",
						ErrorMessage: "Critical fields missing",
						Severity:     "error",
					},
				},
			},

			Transformation: services.TransformationConfig{
				Engine:          "hl7_to_fhir",
				MappingTemplate: "optimized_adt_v4",
				CustomMappings:  []services.FieldMapping{}, // Use template only for performance
				PostProcessing: []services.PostProcessingStep{
					{
						Type: "minimal_metadata",
						Config: map[string]interface{}{
							"essential_only": true,
						},
					},
				},
			},

			BusinessLogic: services.BusinessLogicConfig{
				RulesEngine: services.RulesEngineConfig{
					Enabled: false, // Disabled for maximum performance
				},
			},

			Destinations: []services.DestinationConfig{
				{
					DestinationID: uuid.New().String(),
					Type:          "fhir_api",
					Config: map[string]interface{}{
						"base_url":         "http://localhost:8080/fhir",
						"timeout":          10000,
						"connection_pool":  50,
						"parallel_uploads": 20,
						"batch_size":       50,
						"compression":      true,
					},
					ErrorHandling: services.ErrorHandlingConfig{
						RetryCount:      2, // Minimal retries for performance
						RetryDelay:      500,
						DeadLetterQueue: true,
					},
				},
			},
		},

		Monitoring: services.MonitoringConfig{
			MetricsEnabled: true,
			AlertThresholds: map[string]float64{
				"processing_time_ms":      500,
				"throughput_per_second":   500,
				"memory_usage_mb":         1024,
				"connection_pool_usage":   0.8,
			},
		},
	}
}

// CreateSecureMLLPConfig creates a security-focused MLLP configuration
func CreateSecureMLLPConfig() *services.InterfaceConfig {
	interfaceID := uuid.New().String()

	return &services.InterfaceConfig{
		InterfaceID: interfaceID,
		Name:        "Secure MLLP with Enhanced Validation",
		Description: "Security-focused MLLP interface with comprehensive validation and audit logging",
		Version:     "1.0.0",
		Status:      "active",
		CreatedAt:   time.Now(),
		UpdatedAt:   time.Now(),
		CreatedBy:   "system",
		UpdatedBy:   "system",

		Pipeline: services.PipelineConfig{
			Input: services.InputConfig{
				Type: "mllp",
				ConnectorConfig: map[string]interface{}{
					"host":                "0.0.0.0",
					"port":                2580,
					"max_connections":     10,
					"tls_enabled":         true,
					"tls_cert_file":       "/etc/ssl/certs/server.crt",
					"tls_key_file":        "/etc/ssl/private/server.key",
					"client_auth":         true,
					"trusted_ca_file":     "/etc/ssl/certs/ca.crt",
					"connection_logging":  true,
					"audit_all_messages":  true,
				},
				Validation: services.InputValidationConfig{
					Enabled: true,
					Rules: []services.ValidationRule{
						{
							RuleType:    "source_ip_whitelist",
							FieldPath:   "connection.source_ip",
							ErrorAction: "reject",
						},
						{
							RuleType:    "message_size_limit",
							FieldPath:   "message.size",
							ErrorAction: "reject",
						},
						{
							RuleType:    "rate_limiting",
							FieldPath:   "connection.rate",
							ErrorAction: "throttle",
						},
					},
				},
				Preprocessing: services.PreprocessingConfig{
					Enabled: true,
					Steps: []services.PreprocessingStep{
						{
							Type: "security_scan",
							Config: map[string]interface{}{
								"check_malformed_data": true,
								"check_sql_injection":  true,
								"check_xss_attempts":   true,
							},
						},
						{
							Type: "audit_logging",
							Config: map[string]interface{}{
								"log_all_fields":    false,
								"log_phi_fields":    false,
								"log_metadata_only": true,
								"encrypt_logs":      true,
							},
						},
					},
				},
			},

			Validation: services.ValidationConfig{
				SchemaValidation: services.SchemaValidationConfig{
					Enabled:    true,
					SchemaType: "hl7",
					StrictMode: true, // Strict mode for security
				},
				BusinessRules: []services.BusinessRule{
					{
						RuleID:       "phi_data_validation",
						Condition:    "PID segment exists",
						Validation:   "phi_compliance_check",
						ErrorMessage: "PHI data validation failed",
						Severity:     "error",
					},
					{
						RuleID:       "sender_authorization",
						Condition:    "MSH.3 is authorized",
						Validation:   "sender_whitelist",
						ErrorMessage: "Unauthorized sender",
						Severity:     "error",
					},
				},
				CustomValidators: []services.CustomValidator{
					{
						Name: "hipaa_compliance_validator",
						Type: "security",
						Code: "function validate(message) { /* HIPAA validation logic */ return true; }",
					},
				},
			},

			Transformation: services.TransformationConfig{
				Engine:          "hl7_to_fhir",
				MappingTemplate: "secure_adt_v4",
				PostProcessing: []services.PostProcessingStep{
					{
						Type: "data_anonymization",
						Config: map[string]interface{}{
							"anonymize_fields":    []string{"name", "ssn", "phone"},
							"preserve_clinical":   true,
							"audit_anonymization": true,
						},
					},
					{
						Type: "encryption",
						Config: map[string]interface{}{
							"encrypt_phi_fields": true,
							"key_management":     "vault",
						},
					},
				},
			},

			Destinations: []services.DestinationConfig{
				{
					DestinationID: uuid.New().String(),
					Type:          "fhir_api",
					Config: map[string]interface{}{
						"base_url":          "https://secure-fhir-server:8443/fhir",
						"timeout":           30000,
						"tls_verify":        true,
						"client_cert":       "/etc/ssl/certs/client.crt",
						"client_key":        "/etc/ssl/private/client.key",
						"oauth2_enabled":    true,
						"oauth2_endpoint":   "https://auth-server/oauth2/token",
						"audit_all_requests": true,
					},
					ErrorHandling: services.ErrorHandlingConfig{
						RetryCount:      3,
						RetryDelay:      5000,
						DeadLetterQueue: true,
					},
				},
			},
		},

		Monitoring: services.MonitoringConfig{
			MetricsEnabled: true,
			AlertThresholds: map[string]float64{
				"security_violations":     0.001, // Very low tolerance
				"unauthorized_attempts":   1,
				"tls_handshake_failures":  5,
				"audit_log_failures":     0,
			},
			RetentionPolicy: map[string]int{
				"audit_logs":      2555, // 7 years for HIPAA
				"security_logs":   2555,
				"error_logs":      365,
			},
		},
	}
}

// CreateBusinessRulesConfig creates a configuration with comprehensive business rules
func CreateBusinessRulesConfig() *services.InterfaceConfig {
	interfaceID := uuid.New().String()

	return &services.InterfaceConfig{
		InterfaceID: interfaceID,
		Name:        "Advanced Business Rules Engine",
		Description: "Comprehensive business rules processing with workflow automation",
		Version:     "1.0.0",
		Status:      "active",
		CreatedAt:   time.Now(),
		UpdatedAt:   time.Now(),
		CreatedBy:   "system",
		UpdatedBy:   "system",

		Pipeline: services.PipelineConfig{
			Input: services.InputConfig{
				Type: "mllp",
				ConnectorConfig: map[string]interface{}{
					"host": "0.0.0.0",
					"port": 2581,
				},
			},

			Validation: services.ValidationConfig{
				BusinessRules: []services.BusinessRule{
					{
						RuleID:       "patient_age_validation",
						Condition:    "Patient.birthDate is valid AND age >= 0 AND age <= 120",
						Validation:   "age_range_check",
						ErrorMessage: "Invalid patient age",
						Severity:     "warning",
					},
					{
						RuleID:       "insurance_validation",
						Condition:    "Patient.coverage exists",
						Validation:   "insurance_eligibility_check",
						ErrorMessage: "Insurance validation required",
						Severity:     "warning",
					},
				},
			},

			Transformation: services.TransformationConfig{
				Engine:          "hl7_to_fhir",
				MappingTemplate: "standard_adt_v4",
			},

			BusinessLogic: services.BusinessLogicConfig{
				RulesEngine: services.RulesEngineConfig{
					Enabled: true,
					Rules: []services.BusinessLogicRule{
						{
							RuleID:    "duplicate_patient_merge",
							Condition: "Patient.identifier matches existing",
							Action: map[string]interface{}{
								"type":      "merge_patient_records",
								"strategy":  "latest_wins",
								"audit":     true,
								"notify":    true,
							},
						},
						{
							RuleID:    "high_risk_patient_alert",
							Condition: "Patient.age > 65 OR Patient.condition contains 'diabetes'",
							Action: map[string]interface{}{
								"type":      "alert",
								"priority":  "high",
								"recipient": "care_management_team",
								"message":   "High-risk patient identified",
							},
						},
						{
							RuleID:    "insurance_pre_auth",
							Condition: "Encounter.type requires pre-authorization",
							Action: map[string]interface{}{
								"type":     "insurance_check",
								"endpoint": "https://insurance-api.com/preauth",
								"timeout":  10000,
							},
						},
						{
							RuleID:    "quality_measures",
							Condition: "Encounter.diagnosis matches quality_criteria",
							Action: map[string]interface{}{
								"type":      "quality_tracking",
								"measures":  ["HEDIS", "CMS"],
								"calculate": true,
								"store":     true,
							},
						},
					},
				},
				WorkflowAutomation: []services.WorkflowAction{
					{
						Trigger: "patient_admitted",
						Actions: []map[string]interface{}{
							{
								"type":     "bed_assignment",
								"service":  "bed_management",
								"timeout":  30000,
							},
							{
								"type":     "care_team_notification",
								"teams":    []string{"nursing", "physician", "pharmacy"},
								"method":   "secure_message",
							},
							{
								"type":     "care_plan_initialization",
								"template": "standard_admission",
								"customize": true,
							},
						},
					},
					{
						Trigger: "patient_discharged",
						Actions: []map[string]interface{}{
							{
								"type":      "discharge_summary",
								"generate":  true,
								"send_to":   "primary_care_physician",
							},
							{
								"type":      "follow_up_scheduling",
								"days":      7,
								"auto_book": false,
							},
							{
								"type":      "medication_reconciliation",
								"required":  true,
								"pharmacy_notification": true,
							},
						},
					},
					{
						Trigger: "lab_critical_value",
						Actions: []map[string]interface{}{
							{
								"type":     "immediate_alert",
								"priority": "critical",
								"targets":  []string{"attending_physician", "charge_nurse"},
								"escalate": 300, // 5 minutes
							},
							{
								"type":      "auto_reorder",
								"condition": "confirmation_required",
								"delay":     3600, // 1 hour
							},
						},
					},
				},
			},

			Destinations: []services.DestinationConfig{
				{
					DestinationID: uuid.New().String(),
					Type:          "fhir_api",
					Config: map[string]interface{}{
						"base_url": "http://localhost:8080/fhir",
						"timeout":  30000,
					},
				},
				{
					DestinationID: uuid.New().String(),
					Type:          "queue",
					Config: map[string]interface{}{
						"queue_name": "business_events",
						"exchange":   "workflow",
					},
					RoutingRules: []services.RoutingRule{
						{
							Condition:    "business_event_triggered == true",
							ResourceType: "*",
							Operation:    "publish",
						},
					},
				},
			},
		},

		Monitoring: services.MonitoringConfig{
			MetricsEnabled: true,
			AlertThresholds: map[string]float64{
				"business_rule_failures":   0.02,
				"workflow_timeouts":        0.01,
				"integration_failures":     0.05,
			},
		},
	}
}