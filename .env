# ezHealthKonnect Environment Configuration

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ezhealthkonnect
DB_USER=ezhealth_user
DB_PASSWORD=secure_password_change_me
DB_SSL=false

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
NODE_ENV=development
PORT=3000

# =============================================================================
# SECURITY (Update these with secure random strings)
# =============================================================================
JWT_SECRET=ezhealthkonnect_jwt_secret_key_for_development_12345678901234567890
SESSION_SECRET=ezhealthkonnect_session_secret_key_for_development_1234567890123
ENCRYPTION_KEY=ezhealthkonnect_encryption_key_for_development_123456789012345

# =============================================================================
# FEATURES
# =============================================================================
ENABLE_POSTGRESQL=true
AUTO_MIGRATE_USERS=true
HIPAA_COMPLIANCE_MODE=true
GDPR_COMPLIANCE_MODE=true
HL7_PROCESSING_MODE=custom
HL7_VALIDATION_LEVEL=basic

# =============================================================================
# PORT CONFIGURATION
# =============================================================================
# Frontend uses PORT=3000 (defined in Application Settings above)
# Go API server handles all backend services including HL7 dictionary
API_PORT=8080

# =============================================================================
# SERVICE CONFIGURATION
# =============================================================================
SERVICE_START_DELAY=3
HEALTH_CHECK_TIMEOUT=30

# =============================================================================
# GO MODULE CONFIGURATION
# =============================================================================
GO_MODULE_NAME=github.com/kshanawaz/ezhealthkonnect
GO_VERSION=1.21

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# NOTE: For options with spaces, use underscores or separate variables
LIVE_SERVER_CORS=true
LIVE_SERVER_WATCH=true
PACKAGE_MANAGER=npm

# =============================================================================
# DEVELOPMENT OPTIONS
# =============================================================================
AUTO_OPEN_BROWSER=true
VERBOSE_LOGGING=false
FRONTEND_TITLE=ezHealthKonnect-Frontend
API_TITLE=ezHealthKonnect-API

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_DIR=logs
FRONTEND_LOG=frontend.log
API_LOG=go-api.log


DICTIONARY_SERVICE_URL=http://localhost:3000


# =============================================================================
# OPTIONAL OVERRIDES (uncomment and modify as needed)
# =============================================================================
# FRONTEND_DIR=public
# GO_MAIN_PATH=main.go
# HL7_PARSER_DIR=hl7
# ADDITIONAL_CORS_ORIGINS=http://localhost:8000,https://yourapp.com
# FRONTEND_HEALTH_URL=http://localhost:3000
# API_HEALTH_URL=http://localhost:8080/health


# =============================================================================
# ezHealthKonnect Schema Enhancement (SAFE TO ADD)
# =============================================================================
# Append these lines to your existing .env file
# Your current HTTP dictionary setup will continue to work unchanged

# Auto-detect schema availability (no breaking changes)
SCHEMA_SOURCE=auto

# Schema directory (only used if schema files are detected)
EZHEALTHKONNECT_SCHEMA_DIR=./schemas/hl7
SCHEMA_SOURCE=filesystem


# Performance settings (only used if schemas available)
ENABLE_SCHEMA_CACHE=true
SCHEMA_CACHE_SIZE=20
DEFAULT_HL7_VERSION=v2.5.1

# FHIR Configuration (optional - has sensible defaults)
DEFAULT_FHIR_VERSION=R4
DEFAULT_FHIR_PROFILE=base
ENABLE_FHIR_CACHE=true
FHIR_CACHE_SIZE=100

