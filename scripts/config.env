# ezHealthKonnect Configuration File
# Edit these values to customize your setup

# =============================================================================
# PORT CONFIGURATION
# =============================================================================

# Frontend server port
FRONTEND_PORT=3000

# HL7 Dictionary service port  
DICTIONARY_PORT=3001

# Go API server port
API_PORT=8080

# =============================================================================
# SERVICE CONFIGURATION
# =============================================================================

# Service startup delay (seconds between starting each service)
SERVICE_START_DELAY=3

# Health check timeout (seconds to wait for services to respond)
HEALTH_CHECK_TIMEOUT=30

# =============================================================================
# FILE PATHS (leave empty for auto-detection)
# =============================================================================

# Path to hl7-dictionary-service.js (auto-detected if empty)
# DICTIONARY_SERVICE_PATH=node-api/hl7-dictionary-service.js

# Frontend directory name (auto-detected if empty)
# FRONTEND_DIR=public

# Go main file path (auto-detected if empty)  
# GO_MAIN_PATH=main.go

# HL7 parser directory (auto-detected if empty)
# HL7_PARSER_DIR=hl7

# =============================================================================
# GO MODULE CONFIGURATION
# =============================================================================

# Go module name (used in go.mod)
GO_MODULE_NAME=github.com/yourusername/ezhealthkonnect

# Go version requirement
GO_VERSION=1.21

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================

# Live server options
LIVE_SERVER_OPTIONS="--cors --watch"

# Which package manager to prefer (npm or yarn)
PACKAGE_MANAGER=npm

# =============================================================================
# DEVELOPMENT OPTIONS
# =============================================================================

# Auto-open browser after startup (true/false)
AUTO_OPEN_BROWSER=true

# Show detailed logs (true/false)
VERBOSE_LOGGING=false

# Service window titles (for process management)
FRONTEND_TITLE="ezHealthKonnect-Frontend"
DICTIONARY_TITLE="ezHealthKonnect-Dictionary"
API_TITLE="ezHealthKonnect-API"

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Additional CORS origins (comma-separated)
# ADDITIONAL_CORS_ORIGINS=http://localhost:8000,https://yourapp.com

# =============================================================================
# LOGGING CONFIGURATION  
# =============================================================================

# Log directory
LOG_DIR=logs

# Log file names
FRONTEND_LOG=frontend.log
DICTIONARY_LOG=hl7-dictionary.log
API_LOG=go-api.log

# =============================================================================
# HEALTH CHECK URLS (auto-generated if empty)
# =============================================================================

# Override health check URLs if needed
# FRONTEND_HEALTH_URL=http://localhost:3000
# DICTIONARY_HEALTH_URL=http://localhost:3001/health
# API_HEALTH_URL=http://localhost:8080/health