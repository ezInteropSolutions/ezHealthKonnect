package controllers

import (
	"context"
	"ezhealthkonnect/models"
	"ezhealthkonnect/services"
	"log"
	"net/http"
	"time"

	"github.com/gin-gonic/gin"
)

// PipelineVariablesController handles variable registry for no-code UI
type PipelineVariablesController struct {
	pipelineService *services.TransformationPipelineService
}

// NewPipelineVariablesController creates a new controller
func NewPipelineVariablesController(pipelineService *services.TransformationPipelineService) *PipelineVariablesController {
	return &PipelineVariablesController{
		pipelineService: pipelineService,
	}
}

// GetAvailableVariablesRequest represents the request for getting available variables
type GetAvailableVariablesRequest struct {
	PipelineID string                 `json:"pipeline_id" binding:"required"`
	Message    map[string]interface{} `json:"message,omitempty"` // Optional: provide sample message for preview
}

// GetAvailableVariablesResponse represents the response with variable metadata
type GetAvailableVariablesResponse struct {
	Variables []models.VariableMetadata `json:"variables"`
	GroupedBy map[string][]models.VariableMetadata `json:"grouped_by_step"` // Grouped by step for UI
}

// GetAvailableVariables returns all variables that will be available during pipeline execution
// This is used for IntelliSense and drag-drop variable panels
// @Summary Get available variables for pipeline
// @Description Returns all variables that executors will produce, grouped by step
// @Tags Pipeline Variables
// @Accept json
// @Produce json
// @Param request body GetAvailableVariablesRequest true "Request with pipeline ID and optional sample message"
// @Success 200 {object} GetAvailableVariablesResponse
// @Router /api/pipelines/variables [post]
func (ctrl *PipelineVariablesController) GetAvailableVariables(c *gin.Context) {
	var req GetAvailableVariablesRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		return
	}

	// Get pipeline
	pipeline, err := ctrl.pipelineService.GetPipelineByID(req.PipelineID)
	if err != nil {
		c.JSON(http.StatusNotFound, gin.H{"error": "Pipeline not found"})
		return
	}

	// Simulate pipeline execution to discover available variables
	// If sample message provided, use it; otherwise use mock data
	inputData := req.Message
	if inputData == nil {
		inputData = ctrl.createMockHL7Message()
	}

	// Execute pipeline with dry-run to collect variable metadata
	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
	defer cancel()

	result, err := ctrl.pipelineService.ExecutePipeline(ctx, pipeline, inputData)
	if err != nil {
		log.Printf("⚠️  Pipeline execution failed during variable discovery: %v", err)
		// Continue anyway - we can still return partial results
	}

	// Extract variables from execution context
	var variables []models.VariableMetadata
	groupedByStep := make(map[string][]models.VariableMetadata)

	if result != nil && result.ExecutionLog != nil {
		// Build variable context from execution log
		varContext := models.NewPipelineVariableContext()

		for _, stepLog := range result.ExecutionLog {
			if stepLog.StepOutput != nil && stepLog.StepOutput.OutputData != nil {
				varContext.RegisterStepOutput(stepLog.StepName, stepLog.StepType, stepLog.StepOutput.OutputData)
			}
		}

		// Get all variable metadata
		variables = varContext.GetMetadata()

		// Group by step
		for _, meta := range variables {
			groupedByStep[meta.StepName] = append(groupedByStep[meta.StepName], meta)
		}
	}

	c.JSON(http.StatusOK, GetAvailableVariablesResponse{
		Variables:     variables,
		GroupedBy:     groupedByStep,
	})
}

// createMockHL7Message creates a mock HL7 message for variable discovery
func (ctrl *PipelineVariablesController) createMockHL7Message() map[string]interface{} {
	return map[string]interface{}{
		"enhancedSegments": map[string]interface{}{
			"MSH": map[string]interface{}{
				"key": "MSH",
				"fields": []map[string]interface{}{
					{"key": "MSH.3", "value": "SENDING_APP"},
					{"key": "MSH.9", "value": "ADT^A01"},
				},
			},
			"PID": map[string]interface{}{
				"key": "PID",
				"fields": []map[string]interface{}{
					{"key": "PID.3.1", "value": "P123456"},
					{"key": "PID.5.1", "value": "DOE"},
					{"key": "PID.5.2", "value": "JOHN"},
					{"key": "PID.7", "value": "19800101"},
				},
			},
		},
		"messageType": map[string]interface{}{
			"code":  "ADT",
			"event": "A01",
		},
	}
}

// GetVariablesByStep returns variables for a specific step in the pipeline
// @Summary Get variables produced by specific step
// @Description Returns variable metadata for a single step
// @Tags Pipeline Variables
// @Param pipeline_id path string true "Pipeline ID"
// @Param step_id path string true "Step ID"
// @Success 200 {array} models.VariableMetadata
// @Router /api/pipelines/{pipeline_id}/steps/{step_id}/variables [get]
func (ctrl *PipelineVariablesController) GetVariablesByStep(c *gin.Context) {
	pipelineID := c.Param("pipeline_id")
	stepID := c.Param("step_id")

	// This would normally query step configuration to determine its output variables
	// For now, return empty array
	log.Printf("Getting variables for pipeline %s, step %s", pipelineID, stepID)

	c.JSON(http.StatusOK, []models.VariableMetadata{})
}
