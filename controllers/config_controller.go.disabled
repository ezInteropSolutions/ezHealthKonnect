// GetRuntimeStats returns runtime statistics
func (cc *ConfigController) GetRuntimeStats(c *gin.Context) {
	if cc.interfaceEngine == nil {
		c.JSON(http.StatusServiceUnavailable, gin.H{
			"success": false,
			"error":   "Interface engine not available",
		})
		return
	}

	activeMessages := cc.interfaceEngine.GetActiveMessages()

	c.JSON(http.StatusOK, gin.H{
		"success": true,
		"data": gin.H{
			"active_messages": len(activeMessages),
			"timestamp":       "2025-01-01T00:00:00Z",
		},
	})
}

// GetActiveProcesses returns currently active processing instances
func (cc *ConfigController) GetActiveProcesses(c *gin.Context) {
	if cc.interfaceEngine == nil {
		c.JSON(http.StatusServiceUnavailable, gin.H{
			"success": false,
			"error":   "Interface engine not available",
		})
		return
	}

	activeMessages := cc.interfaceEngine.GetActiveMessages()

	processes := make([]gin.H, 0)
	for messageID, message := range activeMessages {
		processes = append(processes, gin.H{
			"message_id":   messageID,
			"interface_id": message.InterfaceID,
			"status":       "processing",
			"created_at":   message.CreatedAt,
		})
	}

	c.JSON(http.StatusOK, gin.H{
		"success": true,
		"data": gin.H{
			"active_processes": processes,
			"count":           len(processes),
		},
	})
}

// GetInterfaceStats returns statistics for a specific interface
func (cc *ConfigController) GetInterfaceStats(c *gin.Context) {
	interfaceID := c.Param("id")

	if cc.interfaceEngine == nil {
		c.JSON(http.StatusServiceUnavailable, gin.H{
			"success": false,
			"error":   "Interface engine not available",
		})
		return
	}

	stats, exists := cc.interfaceEngine.GetInterfaceStats(interfaceID)
	if !exists {
		c.JSON(http.StatusNotFound, gin.H{
			"success": false,
			"error":   "No statistics found for interface",
		})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"success": true,
		"data":    stats,
	})
}

// ReloadAllConfigurations forces reload of all configurations
func (cc *ConfigController) ReloadAllConfigurations(c *gin.Context) {
	// Get all active configurations
	configs, err := cc.configManager.GetActiveConfigs()
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"success": false,
			"error":   "Failed to get configurations",
			"details": err.Error(),
		})
		return
	}

	reloadedCount := 0
	for _, config := range configs {
		_, err := cc.configManager.ReloadConfig(config.InterfaceID)
		if err == nil {
			reloadedCount++
		}
	}

	c.JSON(http.StatusOK, gin.H{
		"success": true,
		"message": "Configurations reloaded",
		"data": gin.H{
			"total_configs":   len(configs),
			"reloaded_configs": reloadedCount,
		},
	})
}

// GetConfigurationHealth returns health status of the configuration system
func (cc *ConfigController) GetConfigurationHealth(c *gin.Context) {
	health := gin.H{
		"status":    "healthy",
		"timestamp": "2025-01-01T00:00:00Z",
		"services": gin.H{
			"config_manager":   cc.configManager != nil,
			"interface_engine": cc.interfaceEngine != nil,
			"migration_service": cc.migrationService != nil,
		},
	}

	if cc.configManager != nil {
		configs, err := cc.configManager.GetActiveConfigs()
		if err != nil {
			health["config_manager_error"] = err.Error()
		} else {
			health["active_configurations"] = len(configs)
		}
	}

	c.JSON(http.StatusOK, gin.H{
		"success": true,
		"data":    health,
	})
}