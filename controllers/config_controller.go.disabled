package controllers

import (
	"ezhealthkonnect/services"
	"net/http"
	"strconv"

	"github.com/gin-gonic/gin"
)

// ConfigController handles configuration management API endpoints
type ConfigController struct {
	configManager   *services.ConfigManager
	interfaceEngine *services.InterfaceEngine
	migrationService *services.MigrationService
}

// NewConfigController creates a new configuration controller
func NewConfigController(configManager *services.ConfigManager, interfaceEngine *services.InterfaceEngine, migrationService *services.MigrationService) *ConfigController {
	return &ConfigController{
		configManager:   configManager,
		interfaceEngine: interfaceEngine,
		migrationService: migrationService,
	}
}

// RegisterRoutes registers all configuration management routes
func (cc *ConfigController) RegisterRoutes(router *gin.RouterGroup) {
	config := router.Group("/config")
	{
		// Configuration CRUD operations
		config.GET("/interfaces", cc.GetAllConfigurations)
		config.GET("/interfaces/:id", cc.GetConfiguration)
		config.POST("/interfaces", cc.CreateConfiguration)
		config.PUT("/interfaces/:id", cc.UpdateConfiguration)
		config.DELETE("/interfaces/:id", cc.DeleteConfiguration)

		// Configuration management
		config.POST("/interfaces/:id/reload", cc.ReloadConfiguration)
		config.GET("/interfaces/:id/versions", cc.GetConfigurationVersions)
		config.GET("/interfaces/:id/versions/:version", cc.GetConfigurationVersion)

		// Configuration validation
		config.POST("/interfaces/validate", cc.ValidateConfiguration)

		// Template management
		config.GET("/templates", cc.GetMappingTemplates)
		config.GET("/templates/:id", cc.GetMappingTemplate)
		config.POST("/templates", cc.CreateMappingTemplate)
		config.PUT("/templates/:id", cc.UpdateMappingTemplate)

		// Migration endpoints
		config.POST("/migrate", cc.StartMigration)
		config.GET("/migrate/status", cc.GetMigrationStatus)
		config.POST("/migrate/validate", cc.ValidateMigration)

		// Runtime monitoring
		config.GET("/runtime/stats", cc.GetRuntimeStats)
		config.GET("/runtime/active", cc.GetActiveProcesses)
		config.GET("/interfaces/:id/stats", cc.GetInterfaceStats)

		// Hot reload management
		config.POST("/reload/all", cc.ReloadAllConfigurations)
		config.GET("/health", cc.GetConfigurationHealth)
	}
}

// GetAllConfigurations returns all interface configurations
func (cc *ConfigController) GetAllConfigurations(c *gin.Context) {
	// Get query parameters
	status := c.Query("status")
	limit := c.DefaultQuery("limit", "50")
	offset := c.DefaultQuery("offset", "0")

	limitInt, _ := strconv.Atoi(limit)
	offsetInt, _ := strconv.Atoi(offset)

	// Get configurations based on status
	var configs []*services.InterfaceConfig
	var err error

	if status == "active" {
		configs, err = cc.configManager.GetActiveConfigs()
	} else {
		// For now, return active configs as we don't have a GetAllConfigs method
		configs, err = cc.configManager.GetActiveConfigs()
	}

	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"success": false,
			"error":   "Failed to retrieve configurations",
			"details": err.Error(),
		})
		return
	}

	// Apply pagination
	total := len(configs)
	start := offsetInt
	end := start + limitInt

	if start > total {
		start = total
	}
	if end > total {
		end = total
	}

	paginatedConfigs := configs[start:end]

	c.JSON(http.StatusOK, gin.H{
		"success": true,
		"data": gin.H{
			"configurations": paginatedConfigs,
			"pagination": gin.H{
				"total":  total,
				"limit":  limitInt,
				"offset": offsetInt,
				"count":  len(paginatedConfigs),
			},
		},
	})
}

// GetConfiguration returns a specific interface configuration
func (cc *ConfigController) GetConfiguration(c *gin.Context) {
	interfaceID := c.Param("id")

	config, err := cc.configManager.LoadConfig(interfaceID)
	if err != nil {
		c.JSON(http.StatusNotFound, gin.H{
			"success": false,
			"error":   "Configuration not found",
			"details": err.Error(),
		})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"success": true,
		"data":    config,
	})
}

// CreateConfiguration creates a new interface configuration
func (cc *ConfigController) CreateConfiguration(c *gin.Context) {
	var config services.InterfaceConfig

	if err := c.ShouldBindJSON(&config); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"success": false,
			"error":   "Invalid configuration format",
			"details": err.Error(),
		})
		return
	}

	// Validate configuration
	if err := cc.configManager.ValidateConfig(&config); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"success": false,
			"error":   "Configuration validation failed",
			"details": err.Error(),
		})
		return
	}

	// Save configuration
	if err := cc.configManager.SaveConfig(&config); err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"success": false,
			"error":   "Failed to save configuration",
			"details": err.Error(),
		})
		return
	}

	c.JSON(http.StatusCreated, gin.H{
		"success": true,
		"data":    config,
		"message": "Configuration created successfully",
	})
}

// UpdateConfiguration updates an existing interface configuration
func (cc *ConfigController) UpdateConfiguration(c *gin.Context) {
	interfaceID := c.Param("id")

	var config services.InterfaceConfig
	if err := c.ShouldBindJSON(&config); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"success": false,
			"error":   "Invalid configuration format",
			"details": err.Error(),
		})
		return
	}

	// Ensure the interface ID matches
	config.InterfaceID = interfaceID

	// Validate configuration
	if err := cc.configManager.ValidateConfig(&config); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"success": false,
			"error":   "Configuration validation failed",
			"details": err.Error(),
		})
		return
	}

	// Save configuration
	if err := cc.configManager.SaveConfig(&config); err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"success": false,
			"error":   "Failed to update configuration",
			"details": err.Error(),
		})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"success": true,
		"data":    config,
		"message": "Configuration updated successfully",
	})
}

