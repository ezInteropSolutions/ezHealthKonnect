// ValidateConfiguration validates a configuration without saving
func (cc *ConfigController) ValidateConfiguration(c *gin.Context) {
	var config services.InterfaceConfig

	if err := c.ShouldBindJSON(&config); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"success": false,
			"error":   "Invalid configuration format",
			"details": err.Error(),
		})
		return
	}

	// Validate configuration
	if err := cc.configManager.ValidateConfig(&config); err != nil {
		c.JSON(http.StatusOK, gin.H{
			"success": false,
			"valid":   false,
			"errors":  []string{err.Error()},
		})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"success": true,
		"valid":   true,
		"message": "Configuration is valid",
	})
}

