// StartMigration starts PostgreSQL to MongoDB migration
func (cc *ConfigController) StartMigration(c *gin.Context) {
	// Get migration options
	dryRun := c.DefaultQuery("dry_run", "false") == "true"

	if cc.migrationService == nil {
		c.JSON(http.StatusServiceUnavailable, gin.H{
			"success": false,
			"error":   "Migration service not available",
		})
		return
	}

	// Start migration in background
	go func() {
		stats, err := cc.migrationService.MigrateAll(c.Request.Context())
		if err != nil {
			// Log error - in production, you'd want to store this in a job queue
			println("Migration failed:", err.Error())
		} else {
			// Log success
			println("Migration completed:", stats.Duration)
		}
	}()

	c.JSON(http.StatusAccepted, gin.H{
		"success": true,
		"message": "Migration started",
		"dry_run": dryRun,
	})
}

// GetMigrationStatus returns the current migration status
func (cc *ConfigController) GetMigrationStatus(c *gin.Context) {
	if cc.migrationService == nil {
		c.JSON(http.StatusServiceUnavailable, gin.H{
			"success": false,
			"error":   "Migration service not available",
		})
		return
	}

	stats, err := cc.migrationService.GetMigrationProgress(c.Request.Context())
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"success": false,
			"error":   "Failed to get migration status",
			"details": err.Error(),
		})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"success": true,
		"data":    stats,
	})
}

