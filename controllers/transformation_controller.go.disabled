// controllers/transformation_controller.go
// Transformation Controller for Universal Interface Engine
//
// 🎯 PURPOSE: HTTP API endpoints for transformation services
package controllers

import (
	"database/sql"
	"encoding/json"
	"net/http"
	"strconv"
	"time"

	"ezhealthkonnect/services"

	"github.com/gin-gonic/gin"
)

// TransformationController handles transformation API endpoints
type TransformationController struct {
	db               *sql.DB
	hl7Service       *services.HL7TransformationService
	fhirService      *services.FHIRTransformationService
	jsonService      *services.JSONTransformationService
	xmlService       *services.XMLTransformationService
	customService    *services.CustomTransformationService
	pipelineService  *services.TransformationPipelineService
}

// NewTransformationController creates a new transformation controller
func NewTransformationController(database *sql.DB) *TransformationController {
	// Initialize transformation services
	hl7Service := services.NewHL7TransformationService(database)
	fhirService := services.NewFHIRTransformationService(database)
	jsonService := services.NewJSONTransformationService(database)
	xmlService := services.NewXMLTransformationService(database)
	customService := services.NewCustomTransformationService(database)

	// Initialize pipeline service with all transformation services
	pipelineService := services.NewTransformationPipelineService(
		database,
		hl7Service,
		fhirService,
		jsonService,
		xmlService,
		customService,
	)

	return &TransformationController{
		db:              database,
		hl7Service:      hl7Service,
		fhirService:     fhirService,
		jsonService:     jsonService,
		xmlService:      xmlService,
		customService:   customService,
		pipelineService: pipelineService,
	}
}

// RegisterRoutes registers transformation routes
func (c *TransformationController) RegisterRoutes(router *gin.RouterGroup) {
	// Universal transformation endpoint
	router.POST("/transform", c.UniversalTransform)

	// Service-specific transformation endpoints
	router.POST("/transform/hl7", c.TransformHL7)
	router.POST("/transform/fhir", c.TransformFHIR)
	router.POST("/transform/json", c.TransformJSON)
	router.POST("/transform/xml", c.TransformXML)
	router.POST("/transform/custom", c.TransformCustom)

	// Pipeline endpoints
	router.POST("/pipeline/execute", c.ExecutePipeline)
	router.GET("/pipeline/history/:executionId", c.GetExecutionHistory)
	router.POST("/pipeline/rollback/:executionId", c.PerformRollback)

	// Service status and metrics
	router.GET("/transform/status", c.GetTransformationStatus)
	router.GET("/transform/metrics", c.GetTransformationMetrics)

	// Configuration endpoints
	router.GET("/transform/supported-types", c.GetSupportedTypes)
	router.GET("/transform/service-info", c.GetServiceInfo)
}

// UniversalTransform handles universal transformation requests
func (c *TransformationController) UniversalTransform(ctx *gin.Context) {
	var request struct {
		MessageID     string                    `json:"messageId"`
		SourceFormat  services.MessageType      `json:"sourceFormat"`
		TargetFormat  services.MessageType      `json:"targetFormat"`
		Content       interface{}               `json:"content"`
		Options       map[string]interface{}    `json:"options,omitempty"`
	}

	if err := ctx.ShouldBindJSON(&request); err != nil {
		ctx.JSON(http.StatusBadRequest, gin.H{
			"success": false,
			"error":   "Invalid request format",
			"details": err.Error(),
		})
		return
	}

	// Create universal message
	contentBytes, _ := json.Marshal(request.Content)
	message := services.NewUniversalMessage(
		request.SourceFormat,
		contentBytes,
		"API_REQUEST",
	)

	if request.MessageID != "" {
		message.ID = request.MessageID
	}

	// Parse content based on source format
	switch request.SourceFormat {
	case services.MessageTypeJSON:
		if contentMap, ok := request.Content.(map[string]interface{}); ok {
			message.ParsedContent = contentMap
		}
	case services.MessageTypeHL7:
		// Raw HL7 content should be parsed by HL7 service
	case services.MessageTypeXML:
		// Raw XML content should be parsed by XML service
	}

	// Transform based on target format
	var err error
	switch request.TargetFormat {
	case services.MessageTypeHL7:
		err = c.hl7Service.Transform(ctx, message)
	case services.MessageTypeFHIR:
		err = c.fhirService.Transform(ctx, message)
	case services.MessageTypeJSON:
		err = c.jsonService.Transform(ctx, message)
	case services.MessageTypeXML:
		err = c.xmlService.Transform(ctx, message)
	default:
		ctx.JSON(http.StatusBadRequest, gin.H{
			"success": false,
			"error":   "Unsupported target format",
			"targetFormat": request.TargetFormat,
		})
		return
	}

	if err != nil {
		ctx.JSON(http.StatusInternalServerError, gin.H{
			"success": false,
			"error":   "Transformation failed",
			"details": err.Error(),
		})
		return
	}

	ctx.JSON(http.StatusOK, gin.H{
		"success": true,
		"messageId": message.ID,
		"sourceFormat": request.SourceFormat,
		"targetFormat": request.TargetFormat,
		"transformedData": message.ParsedContent,
		"transformationLineage": message.TransformationLineage,
		"processingMetrics": message.GetProcessingSummary(),
	})
}

// TransformHL7 handles HL7-specific transformations
func (c *TransformationController) TransformHL7(ctx *gin.Context) {
	var request services.HL7TransformRequest

	if err := ctx.ShouldBindJSON(&request); err != nil {
		ctx.JSON(http.StatusBadRequest, gin.H{
			"success": false,
			"error":   "Invalid HL7 request format",
			"details": err.Error(),
		})
		return
	}

	response, err := c.hl7Service.TransformHL7Message(ctx, &request)
	if err != nil {
		ctx.JSON(http.StatusInternalServerError, gin.H{
			"success": false,
			"error":   "HL7 transformation failed",
			"details": err.Error(),
		})
		return
	}

	ctx.JSON(http.StatusOK, response)
}

