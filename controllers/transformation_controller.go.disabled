// GetExecutionHistory gets pipeline execution history
func (c *TransformationController) GetExecutionHistory(ctx *gin.Context) {
	executionID := ctx.Param("executionId")

	history, exists := c.pipelineService.GetExecutionHistory(executionID)
	if !exists {
		ctx.JSON(http.StatusNotFound, gin.H{
			"success": false,
			"error":   "Execution history not found",
			"executionId": executionID,
		})
		return
	}

	ctx.JSON(http.StatusOK, gin.H{
		"success": true,
		"executionId": executionID,
		"history": history,
	})
}

// PerformRollback performs a pipeline rollback
func (c *TransformationController) PerformRollback(ctx *gin.Context) {
	executionID := ctx.Param("executionId")

	plan, exists := c.pipelineService.GetRollbackPlan(executionID)
	if !exists {
		ctx.JSON(http.StatusNotFound, gin.H{
			"success": false,
			"error":   "Rollback plan not found",
			"executionId": executionID,
		})
		return
	}

	ctx.JSON(http.StatusOK, gin.H{
		"success": true,
		"executionId": executionID,
		"rollbackPlan": plan,
		"message": "Rollback information retrieved successfully",
	})
}

// GetTransformationStatus gets overall transformation service status
func (c *TransformationController) GetTransformationStatus(ctx *gin.Context) {
	status := gin.H{
		"success": true,
		"timestamp": time.Now().Format(time.RFC3339),
		"services": gin.H{
			"hl7": gin.H{
				"status": "operational",
				"metrics": c.hl7Service.GetPerformanceMetrics(),
			},
			"fhir": gin.H{
				"status": "operational",
				"metrics": c.fhirService.GetPerformanceMetrics(),
			},
			"json": gin.H{
				"status": "operational",
				"metrics": c.jsonService.GetPerformanceMetrics(),
			},
			"xml": gin.H{
				"status": "operational",
				"metrics": c.xmlService.GetPerformanceMetrics(),
			},
			"custom": gin.H{
				"status": "operational",
				"metrics": c.customService.GetPerformanceMetrics(),
			},
			"pipeline": gin.H{
				"status": "operational",
				"metrics": c.pipelineService.GetPerformanceMetrics(),
			},
		},
	}

	ctx.JSON(http.StatusOK, status)
}

// GetTransformationMetrics gets aggregated transformation metrics
func (c *TransformationController) GetTransformationMetrics(ctx *gin.Context) {
	hl7Metrics := c.hl7Service.GetPerformanceMetrics()
	fhirMetrics := c.fhirService.GetPerformanceMetrics()
	jsonMetrics := c.jsonService.GetPerformanceMetrics()
	xmlMetrics := c.xmlService.GetPerformanceMetrics()
	customMetrics := c.customService.GetPerformanceMetrics()
	pipelineMetrics := c.pipelineService.GetPerformanceMetrics()

	totalMessages := hl7Metrics.MessagesProcessed + fhirMetrics.ResourcesProcessed +
		jsonMetrics.MessagesProcessed + xmlMetrics.MessagesProcessed +
		customMetrics.RulesExecuted

	metrics := gin.H{
		"success": true,
		"timestamp": time.Now().Format(time.RFC3339),
		"aggregated": gin.H{
			"totalMessages": totalMessages,
			"totalPipelines": pipelineMetrics.PipelinesExecuted,
			"overallSuccessRate": (hl7Metrics.ErrorRate + fhirMetrics.ErrorRate +
				jsonMetrics.ErrorRate + xmlMetrics.ErrorRate + customMetrics.SuccessRate) / 5.0,
			"averageProcessingTime": gin.H{
				"hl7": hl7Metrics.AverageParseTime.String(),
				"fhir": fhirMetrics.AverageTransformTime.String(),
				"json": jsonMetrics.AverageTransformTime.String(),
				"xml": xmlMetrics.AverageTransformTime.String(),
				"pipeline": pipelineMetrics.AverageExecutionTime.String(),
			},
		},
		"services": gin.H{
			"hl7": hl7Metrics,
			"fhir": fhirMetrics,
			"json": jsonMetrics,
			"xml": xmlMetrics,
			"custom": customMetrics,
			"pipeline": pipelineMetrics,
		},
	}

	ctx.JSON(http.StatusOK, metrics)
}

// GetSupportedTypes returns supported message types and formats
func (c *TransformationController) GetSupportedTypes(ctx *gin.Context) {
	supportedTypes := gin.H{
		"success": true,
		"messageTypes": []string{
			string(services.MessageTypeHL7),
			string(services.MessageTypeFHIR),
			string(services.MessageTypeJSON),
			string(services.MessageTypeXML),
			string(services.MessageTypeBinary),
		},
		"transformationPairs": []gin.H{
			{"from": services.MessageTypeHL7, "to": services.MessageTypeFHIR},
			{"from": services.MessageTypeHL7, "to": services.MessageTypeJSON},
			{"from": services.MessageTypeJSON, "to": services.MessageTypeFHIR},
			{"from": services.MessageTypeJSON, "to": services.MessageTypeHL7},
			{"from": services.MessageTypeJSON, "to": services.MessageTypeXML},
			{"from": services.MessageTypeXML, "to": services.MessageTypeJSON},
			{"from": services.MessageTypeXML, "to": services.MessageTypeFHIR},
		},
		"services": gin.H{
			"hl7": gin.H{
				"supportedMessageTypes": c.hl7Service.GetSupportedMessageTypes(),
				"availableTransformations": c.hl7Service.GetCacheStats(),
			},
			"fhir": gin.H{
				"supportedProfiles": c.fhirService.GetSupportedProfiles(),
			},
			"json": gin.H{
				"supportedTransformations": c.jsonService.GetSupportedTransformations(),
				"availableSchemas": c.jsonService.GetAvailableSchemas(),
			},
			"custom": gin.H{
				"availableRules": len(c.customService.ListRules()),
			},
		},
	}

	ctx.JSON(http.StatusOK, supportedTypes)
}

// GetServiceInfo returns detailed service information
func (c *TransformationController) GetServiceInfo(ctx *gin.Context) {
	serviceInfo := gin.H{
		"success": true,
		"version": "1.0.0",
		"description": "Universal Interface Engine Transformation Services",
		"capabilities": gin.H{
			"universalTransformation": true,
			"pipelineOrchestration": true,
			"customRules": true,
			"historyTracking": true,
			"rollbackSupport": true,
			"performanceMetrics": true,
		},
		"services": gin.H{
			"hl7": gin.H{
				"description": "HL7 message parsing and transformation",
				"features": []string{"parsing", "validation", "transformation", "format_conversion"},
			},
			"fhir": gin.H{
				"description": "FHIR resource mapping and validation",
				"features": []string{"resource_creation", "profile_validation", "bundle_management", "narrative_generation"},
			},
			"json": gin.H{
				"description": "JSON message transformation and mapping",
				"features": []string{"schema_validation", "data_type_conversion", "template_processing", "custom_mappings"},
			},
			"xml": gin.H{
				"description": "XML parsing and transformation",
				"features": []string{"xml_parsing", "namespace_handling", "xslt_processing", "format_conversion"},
			},
			"custom": gin.H{
				"description": "User-defined transformation rules",
				"features": []string{"custom_rules", "scripting_support", "condition_evaluation", "dynamic_transformations"},
			},
			"pipeline": gin.H{
				"description": "Multi-step transformation orchestration",
				"features": []string{"step_chaining", "error_handling", "rollback_support", "history_tracking", "parallel_execution"},
			},
		},
		"endpoints": gin.H{
			"universal": "/api/transform",
			"hl7": "/api/transform/hl7",
			"fhir": "/api/transform/fhir",
			"json": "/api/transform/json",
			"xml": "/api/transform/xml",
			"custom": "/api/transform/custom",
			"pipeline": "/api/pipeline/execute",
			"status": "/api/transform/status",
			"metrics": "/api/transform/metrics",
		},
	}

	ctx.JSON(http.StatusOK, serviceInfo)
}

// Cleanup performs maintenance operations
func (c *TransformationController) Cleanup(maxAge time.Duration) {
	olderThan := time.Now().Add(-maxAge)

	// Cleanup history and rollback plans
	historyCount := c.pipelineService.CleanupHistory(olderThan)
	rollbackCount := c.pipelineService.CleanupRollbackPlans(olderThan)

	// Clear service caches
	c.hl7Service.ClearCache()
	c.fhirService.ClearCache()
	c.jsonService.ClearCache()

	log.Printf("✅ Transformation services cleanup completed: %d history entries, %d rollback plans removed",
		historyCount, rollbackCount)
}