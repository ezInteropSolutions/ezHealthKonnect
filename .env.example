# ezHealthKonnect — local development environment
#
# Do not copy this file by hand. Run:
#
#     npm run setup:env
#
# which creates .env (gitignored) with freshly generated secrets, or adds any
# secret missing from an existing .env without touching values already there.
#
# Never commit real values. Every secret below is left empty on purpose: the
# app refuses to start without SESSION_SECRET / JWT_SECRET, and refuses in
# production any value that has ever been public (config/compromised_secrets.json).

# ── Secrets (generated by npm run setup:env) ───────────────────────────────────
SESSION_SECRET=
JWT_SECRET=
APP_CREDENTIAL_KEY=
DB_PASSWORD=
MINIO_PASSWORD=

# ── Non-secret settings ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ezhealthkonnect
DB_USER=ezhealth_user
DB_SSL=false
