{
  "_comment": "What the Standalone application bundle contains. Built ONLY from git-tracked files by cmd/bundle-builder (release.yml). Must cover every runtime COPY in the Dockerfile (enforced by cmd/bundle-builder's tests). 'protected' entries are customer data the installer never moves, replaces or deletes on upgrade; they may never appear in the bundle. 'installerDownloads' are not bundled: the Windows installer downloads PostgreSQL only when it is missing and runs it only if its SHA-256 matches (release.yml passes these to the installer build).",
  "files": [
    "package.json",
    "package-lock.json",
    "app.js",
    "server.js",
    "SYSTEM_DOCUMENTATION.md",
    "installer/ONE_CLICK_INSTALLER_GUIDE.md",
    "LICENSE",
    "COMMERCIAL_LICENSE.md",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "dirs": [
    "controllers",
    "services",
    "middleware",
    "routes",
    "config",
    "processing",
    "public",
    "database",
    "architecture",
    "docs",
    "cda",
    "edi",
    "ncpdp",
    "ncpdptelecom",
    "astm"
  ],
  "exclude": {
    "suffixes": [
      ".go",
      ".test.js",
      ".spec.js",
      ".bak",
      ".old",
      ".new",
      ".orig"
    ],
    "dirNames": [
      "testdata",
      "__tests__",
      "node_modules"
    ],
    "files": [
      "go.mod",
      "go.sum"
    ]
  },
  "windowsFiles": {
    "start-app.ps1": "installer/assets/start-app.ps1"
  },
  "protected": [
    ".env",
    "install-state.json",
    "logs",
    "storage",
    "schemas",
    "schema-dist",
    "uploads",
    "backups",
    "git-repos",
    "cache",
    "tools"
  ],
  "installerDownloads": {
    "postgresql-windows-amd64": {
      "version": "17.11",
      "url": "https://get.enterprisedb.com/postgresql/postgresql-17.11-1-windows-x64.exe",
      "sha256": "f104c552d8495a6f20738c2a03f643164bc64b9985363329e314dec24559f0b7"
    }
  },
  "runtimes": {
    "node": {
      "version": "22.23.3",
      "targets": {
        "linux/amd64": {
          "url": "https://nodejs.org/dist/v22.23.3/node-v22.23.3-linux-x64.tar.gz",
          "sha256": "1084aa36196bba4c3a5e69a1ee388a6e4ff729dad09445fbcd434b28fe3c24af"
        },
        "linux/arm64": {
          "url": "https://nodejs.org/dist/v22.23.3/node-v22.23.3-linux-arm64.tar.gz",
          "sha256": "5ced2d48d1d7198739b7f86804de0171aefb6823b684b12341d3321afc3cb0b2"
        },
        "windows/amd64": {
          "url": "https://nodejs.org/dist/v22.23.3/node-v22.23.3-win-x64.zip",
          "sha256": "2b0ff57b049cda1bbcea2240eec20467018713c1efe1f7360c2681859b90ed71"
        }
      }
    },
    "winsw": {
      "version": "2.12.0",
      "targets": {
        "windows/amd64": {
          "url": "https://github.com/winsw/winsw/releases/download/v2.12.0/WinSW-x64.exe",
          "sha256": "05b82d46ad331cc16bdc00de5c6332c1ef818df8ceefcd49c726553209b3a0da"
        }
      }
    }
  }
}
