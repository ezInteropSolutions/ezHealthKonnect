package services

import (
	"context"
	"ezhealthkonnect/models"
	"fmt"
	"strings"
)

// HL7SegmentExtractorExecutor extracts HL7 segments
type HL7SegmentExtractorExecutor struct{}

func (e *HL7SegmentExtractorExecutor) Execute(
	ctx context.Context,
	step *models.TransformationStep,
	inputData map[string]interface{},
) (map[string]interface{}, error) {
	segments, ok := step.Config["segments"].([]interface{})
	if !ok {
		return inputData, fmt.Errorf("invalid segments configuration")
	}

	outputData := make(map[string]interface{})
	for k, v := range inputData {
		outputData[k] = v
	}

	// Get enhanced segments from parsed HL7
	enhancedSegments := getNestedValue(outputData, "parsed.enhancedSegments")
	if enhancedSegments == nil {
		return outputData, fmt.Errorf("no parsed HL7 data found in input")
	}

	segmentsMap, ok := enhancedSegments.(map[string]interface{})
	if !ok {
		return outputData, fmt.Errorf("invalid enhancedSegments format")
	}

	// Extract requested segments
	for _, segment := range segments {
		segmentMap := segment.(map[string]interface{})
		segmentName := getStringValue(segmentMap, "segment")
		targetPath := getStringValue(segmentMap, "target")
		fields, _ := segmentMap["fields"].([]interface{})

		segmentData, exists := segmentsMap[segmentName]
		if !exists {
			continue
		}

		segmentDataMap, ok := segmentData.(map[string]interface{})
		if !ok {
			continue
		}

		// If specific fields requested, extract only those
		if len(fields) > 0 {
			extractedFields := make(map[string]interface{})
			segmentFields, _ := segmentDataMap["fields"].([]interface{})

			for _, fieldDef := range fields {
				fieldDefMap := fieldDef.(map[string]interface{})
				fieldKey := getStringValue(fieldDefMap, "field")
				fieldTarget := getStringValue(fieldDefMap, "target")

				// Find the field in the segment
				for _, segField := range segmentFields {
					segFieldMap := segField.(map[string]interface{})
					if getStringValue(segFieldMap, "key") == fieldKey {
						extractedFields[fieldTarget] = segFieldMap["value"]
						break
					}
				}
			}

			setNestedValue(outputData, targetPath, extractedFields)
		} else {
			// Extract entire segment
			setNestedValue(outputData, targetPath, segmentDataMap)
		}
	}

	return outputData, nil
}

func (e *HL7SegmentExtractorExecutor) GetStepType() string {
	return "hl7-segment-extractor"
}

func (e *HL7SegmentExtractorExecutor) Validate(step *models.TransformationStep) error {
	segments, ok := step.Config["segments"].([]interface{})
	if !ok || len(segments) == 0 {
		return fmt.Errorf("at least one segment is required")
	}

	for _, segment := range segments {
		segmentMap := segment.(map[string]interface{})
		segmentName := getStringValue(segmentMap, "segment")
		targetPath := getStringValue(segmentMap, "target")

		if segmentName == "" || targetPath == "" {
			return fmt.Errorf("segment and target are required for each segment extraction")
		}
	}

	return nil
}

// FHIRResourceBuilderExecutor builds FHIR resources
type FHIRResourceBuilderExecutor struct{}

func (e *FHIRResourceBuilderExecutor) Execute(
	ctx context.Context,
	step *models.TransformationStep,
	inputData map[string]interface{},
) (map[string]interface{}, error) {
	resourceType := getStringValue(step.Config, "resource_type")
	mappings, ok := step.Config["mappings"].([]interface{})
	if !ok {
		return inputData, fmt.Errorf("invalid mappings configuration")
	}

	outputData := make(map[string]interface{})
	for k, v := range inputData {
		outputData[k] = v
	}

	// Create base FHIR resource
	resource := make(map[string]interface{})
	resource["resourceType"] = resourceType

	// Apply mappings
	for _, mapping := range mappings {
		mappingMap := mapping.(map[string]interface{})
		sourcePath := getStringValue(mappingMap, "source")
		targetPath := getStringValue(mappingMap, "target")
		transform := getStringValue(mappingMap, "transform")
		defaultValue := mappingMap["default"]

		// Get source value
		sourceValue := getNestedValue(outputData, sourcePath)

		// Use default if source is nil
		if sourceValue == nil && defaultValue != nil {
			sourceValue = defaultValue
		}

		// Apply transformation if specified
		if sourceValue != nil && transform != "" {
			sourceValue = e.applyTransform(sourceValue, transform, mappingMap)
		}

		// Set in FHIR resource
		if sourceValue != nil {
			e.setFHIRValue(resource, targetPath, sourceValue)
		}
	}

	// Store FHIR resource
	targetField := getStringValue(step.Config, "target_field")
	if targetField == "" {
		targetField = "fhir.resource"
	}

	setNestedValue(outputData, targetField, resource)

	return outputData, nil
}

func (e *FHIRResourceBuilderExecutor) applyTransform(value interface{}, transform string, config map[string]interface{}) interface{} {
	valueStr := fmt.Sprintf("%v", value)

	switch transform {
	case "name":
		// Transform to FHIR HumanName format
		parts := strings.Split(valueStr, "^")
		name := map[string]interface{}{
			"family": "",
			"given":  []string{},
		}
		if len(parts) > 0 {
			name["family"] = parts[0]
		}
		if len(parts) > 1 {
			name["given"] = []string{parts[1]}
		}
		return name

	case "identifier":
		// Transform to FHIR Identifier format
		system := getStringValue(config, "system")
		return map[string]interface{}{
			"system": system,
			"value":  valueStr,
		}

	case "coding":
		// Transform to FHIR Coding format
		system := getStringValue(config, "system")
		display := getStringValue(config, "display")
		return map[string]interface{}{
			"system":  system,
			"code":    valueStr,
			"display": display,
		}

	case "date":
		// Transform HL7 date to FHIR date
		if len(valueStr) == 8 {
			// YYYYMMDD -> YYYY-MM-DD
			return valueStr[0:4] + "-" + valueStr[4:6] + "-" + valueStr[6:8]
		}
		return valueStr

	case "datetime":
		// Transform HL7 datetime to FHIR datetime
		if len(valueStr) >= 14 {
			// YYYYMMDDHHMMSS -> YYYY-MM-DDTHH:MM:SS
			return valueStr[0:4] + "-" + valueStr[4:6] + "-" + valueStr[6:8] +
				"T" + valueStr[8:10] + ":" + valueStr[10:12] + ":" + valueStr[12:14]
		}
		return valueStr

	case "gender":
		// Transform HL7 gender to FHIR gender
		genderMap := map[string]string{
			"M": "male",
			"F": "female",
			"O": "other",
			"U": "unknown",
		}
		if mapped, exists := genderMap[valueStr]; exists {
			return mapped
		}
		return "unknown"

	case "address":
		// Transform to FHIR Address format
		parts := strings.Split(valueStr, "^")
		address := map[string]interface{}{}
		if len(parts) > 0 && parts[0] != "" {
			address["line"] = []string{parts[0]}
		}
		if len(parts) > 2 && parts[2] != "" {
			address["city"] = parts[2]
		}
		if len(parts) > 3 && parts[3] != "" {
			address["state"] = parts[3]
		}
		if len(parts) > 4 && parts[4] != "" {
			address["postalCode"] = parts[4]
		}
		if len(parts) > 5 && parts[5] != "" {
			address["country"] = parts[5]
		}
		return address

	case "telecom":
		// Transform to FHIR ContactPoint format
		system := getStringValue(config, "telecom_system")
		if system == "" {
			system = "phone"
		}
		return map[string]interface{}{
			"system": system,
			"value":  valueStr,
		}

	default:
		return value
	}
}

func (e *FHIRResourceBuilderExecutor) setFHIRValue(resource map[string]interface{}, path string, value interface{}) {
	keys := strings.Split(path, ".")
	current := resource

	for i := 0; i < len(keys)-1; i++ {
		key := keys[i]
		if _, exists := current[key]; !exists {
			current[key] = make(map[string]interface{})
		}
		current = current[key].(map[string]interface{})
	}

	finalKey := keys[len(keys)-1]

	// Handle array notation
	if strings.HasSuffix(finalKey, "[]") {
		arrayKey := finalKey[:len(finalKey)-2]
		if _, exists := current[arrayKey]; !exists {
			current[arrayKey] = []interface{}{}
		}
		arr := current[arrayKey].([]interface{})
		current[arrayKey] = append(arr, value)
	} else {
		current[finalKey] = value
	}
}

func (e *FHIRResourceBuilderExecutor) GetStepType() string {
	return "fhir-resource-builder"
}

func (e *FHIRResourceBuilderExecutor) Validate(step *models.TransformationStep) error {
	resourceType := getStringValue(step.Config, "resource_type")
	if resourceType == "" {
		return fmt.Errorf("resource_type is required")
	}

	mappings, ok := step.Config["mappings"].([]interface{})
	if !ok || len(mappings) == 0 {
		return fmt.Errorf("at least one mapping is required")
	}

	for _, mapping := range mappings {
		mappingMap := mapping.(map[string]interface{})
		sourcePath := getStringValue(mappingMap, "source")
		targetPath := getStringValue(mappingMap, "target")

		if sourcePath == "" || targetPath == "" {
			return fmt.Errorf("source and target are required for each mapping")
		}
	}

	return nil
}
