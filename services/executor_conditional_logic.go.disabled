package services

import (
	"context"
	"ezhealthkonnect/models"
	"fmt"
	"regexp"
	"strings"
)

// IfThenElseExecutor implements conditional logic
type IfThenElseExecutor struct{}

func (e *IfThenElseExecutor) Execute(
	ctx context.Context,
	step *models.TransformationStep,
	inputData map[string]interface{},
) (map[string]interface{}, error) {
	condition := step.Config["condition"].(map[string]interface{})
	thenActions, _ := step.Config["then"].([]interface{})
	elseActions, _ := step.Config["else"].([]interface{})

	outputData := make(map[string]interface{})
	for k, v := range inputData {
		outputData[k] = v
	}

	// Evaluate condition
	conditionMet, err := e.evaluateCondition(condition, outputData)
	if err != nil {
		return outputData, fmt.Errorf("condition evaluation failed: %v", err)
	}

	// Execute appropriate actions
	var actionsToExecute []interface{}
	if conditionMet {
		actionsToExecute = thenActions
	} else {
		actionsToExecute = elseActions
	}

	for _, action := range actionsToExecute {
		actionMap := action.(map[string]interface{})
		actionType := getStringValue(actionMap, "action")

		switch actionType {
		case "set_value":
			field := getStringValue(actionMap, "field")
			value := actionMap["value"]
			setNestedValue(outputData, field, value)

		case "copy_field":
			sourceField := getStringValue(actionMap, "source")
			targetField := getStringValue(actionMap, "target")
			value := getNestedValue(outputData, sourceField)
			if value != nil {
				setNestedValue(outputData, targetField, value)
			}

		case "delete_field":
			field := getStringValue(actionMap, "field")
			e.deleteField(outputData, field)

		default:
			return outputData, fmt.Errorf("unsupported action: %s", actionType)
		}
	}

	return outputData, nil
}

func (e *IfThenElseExecutor) evaluateCondition(condition map[string]interface{}, data map[string]interface{}) (bool, error) {
	field := getStringValue(condition, "field")
	operator := getStringValue(condition, "operator")
	value := condition["value"]

	fieldValue := getNestedValue(data, field)

	switch operator {
	case "equals":
		return fmt.Sprintf("%v", fieldValue) == fmt.Sprintf("%v", value), nil

	case "not_equals":
		return fmt.Sprintf("%v", fieldValue) != fmt.Sprintf("%v", value), nil

	case "contains":
		fieldStr := fmt.Sprintf("%v", fieldValue)
		valueStr := fmt.Sprintf("%v", value)
		return strings.Contains(fieldStr, valueStr), nil

	case "starts_with":
		fieldStr := fmt.Sprintf("%v", fieldValue)
		valueStr := fmt.Sprintf("%v", value)
		return strings.HasPrefix(fieldStr, valueStr), nil

	case "ends_with":
		fieldStr := fmt.Sprintf("%v", fieldValue)
		valueStr := fmt.Sprintf("%v", value)
		return strings.HasSuffix(fieldStr, valueStr), nil

	case "greater_than":
		fieldNum := toFloat64(fieldValue)
		valueNum := toFloat64(value)
		return fieldNum > valueNum, nil

	case "less_than":
		fieldNum := toFloat64(fieldValue)
		valueNum := toFloat64(value)
		return fieldNum < valueNum, nil

	case "exists":
		return fieldValue != nil, nil

	case "not_exists":
		return fieldValue == nil, nil

	case "regex_match":
		fieldStr := fmt.Sprintf("%v", fieldValue)
		pattern := fmt.Sprintf("%v", value)
		matched, err := regexp.MatchString(pattern, fieldStr)
		if err != nil {
			return false, fmt.Errorf("invalid regex pattern: %v", err)
		}
		return matched, nil

	case "in_list":
		valueList, ok := value.([]interface{})
		if !ok {
			return false, fmt.Errorf("value must be a list for 'in_list' operator")
		}
		fieldStr := fmt.Sprintf("%v", fieldValue)
		for _, item := range valueList {
			if fmt.Sprintf("%v", item) == fieldStr {
				return true, nil
			}
		}
		return false, nil

	default:
		return false, fmt.Errorf("unsupported operator: %s", operator)
	}
}

func (e *IfThenElseExecutor) deleteField(data map[string]interface{}, path string) {
	keys := strings.Split(path, ".")
	if len(keys) == 1 {
		delete(data, keys[0])
		return
	}

	current := data
	for i := 0; i < len(keys)-1; i++ {
		next, ok := current[keys[i]].(map[string]interface{})
		if !ok {
			return
		}
		current = next
	}

	delete(current, keys[len(keys)-1])
}

func (e *IfThenElseExecutor) GetStepType() string {
	return "if-then-else"
}

func (e *IfThenElseExecutor) Validate(step *models.TransformationStep) error {
	condition, ok := step.Config["condition"].(map[string]interface{})
	if !ok {
		return fmt.Errorf("condition is required")
	}

	field := getStringValue(condition, "field")
	operator := getStringValue(condition, "operator")
	if field == "" || operator == "" {
		return fmt.Errorf("condition must have field and operator")
	}

	return nil
}

// SwitchCaseExecutor implements switch-case logic
type SwitchCaseExecutor struct{}

func (e *SwitchCaseExecutor) Execute(
	ctx context.Context,
	step *models.TransformationStep,
	inputData map[string]interface{},
) (map[string]interface{}, error) {
	field := getStringValue(step.Config, "field")
	cases, ok := step.Config["cases"].([]interface{})
	if !ok {
		return inputData, fmt.Errorf("invalid cases configuration")
	}
	defaultActions, _ := step.Config["default"].([]interface{})

	outputData := make(map[string]interface{})
	for k, v := range inputData {
		outputData[k] = v
	}

	fieldValue := getNestedValue(outputData, field)
	fieldStr := fmt.Sprintf("%v", fieldValue)

	// Find matching case
	var matchedActions []interface{}
	matched := false

	for _, caseItem := range cases {
		caseMap := caseItem.(map[string]interface{})
		caseValue := fmt.Sprintf("%v", caseMap["value"])

		if fieldStr == caseValue {
			matchedActions = caseMap["actions"].([]interface{})
			matched = true
			break
		}
	}

	// Use default if no match
	if !matched {
		matchedActions = defaultActions
	}

	// Execute actions
	for _, action := range matchedActions {
		actionMap := action.(map[string]interface{})
		actionType := getStringValue(actionMap, "action")

		switch actionType {
		case "set_value":
			targetField := getStringValue(actionMap, "field")
			value := actionMap["value"]
			setNestedValue(outputData, targetField, value)

		case "copy_field":
			sourceField := getStringValue(actionMap, "source")
			targetField := getStringValue(actionMap, "target")
			value := getNestedValue(outputData, sourceField)
			if value != nil {
				setNestedValue(outputData, targetField, value)
			}

		case "transform":
			targetField := getStringValue(actionMap, "field")
			transformation := getStringValue(actionMap, "transformation")
			value := getNestedValue(outputData, targetField)
			if value != nil {
				transformedValue := e.applyTransformation(value, transformation)
				setNestedValue(outputData, targetField, transformedValue)
			}

		default:
			return outputData, fmt.Errorf("unsupported action: %s", actionType)
		}
	}

	return outputData, nil
}

func (e *SwitchCaseExecutor) applyTransformation(value interface{}, transformation string) interface{} {
	valueStr := fmt.Sprintf("%v", value)

	switch transformation {
	case "uppercase":
		return strings.ToUpper(valueStr)
	case "lowercase":
		return strings.ToLower(valueStr)
	case "trim":
		return strings.TrimSpace(valueStr)
	default:
		return value
	}
}

func (e *SwitchCaseExecutor) GetStepType() string {
	return "switch-case"
}

func (e *SwitchCaseExecutor) Validate(step *models.TransformationStep) error {
	field := getStringValue(step.Config, "field")
	if field == "" {
		return fmt.Errorf("field is required")
	}

	cases, ok := step.Config["cases"].([]interface{})
	if !ok || len(cases) == 0 {
		return fmt.Errorf("at least one case is required")
	}

	return nil
}

// FilterExecutor filters data based on conditions
type FilterExecutor struct{}

func (e *FilterExecutor) Execute(
	ctx context.Context,
	step *models.TransformationStep,
	inputData map[string]interface{},
) (map[string]interface{}, error) {
	conditions, ok := step.Config["conditions"].([]interface{})
	if !ok {
		return inputData, fmt.Errorf("invalid conditions configuration")
	}

	logicOperator := getStringValue(step.Config, "logic") // "AND" or "OR"
	if logicOperator == "" {
		logicOperator = "AND"
	}

	action := getStringValue(step.Config, "action") // "pass" or "block"
	if action == "" {
		action = "pass"
	}

	outputData := make(map[string]interface{})
	for k, v := range inputData {
		outputData[k] = v
	}

	// Evaluate all conditions
	results := make([]bool, len(conditions))
	for i, condition := range conditions {
		condMap := condition.(map[string]interface{})
		result, err := e.evaluateCondition(condMap, outputData)
		if err != nil {
			return outputData, fmt.Errorf("condition %d evaluation failed: %v", i, err)
		}
		results[i] = result
	}

	// Apply logic operator
	var finalResult bool
	if logicOperator == "AND" {
		finalResult = true
		for _, result := range results {
			finalResult = finalResult && result
		}
	} else { // OR
		finalResult = false
		for _, result := range results {
			finalResult = finalResult || result
		}
	}

	// Determine if we should pass or block
	shouldPass := (action == "pass" && finalResult) || (action == "block" && !finalResult)

	if !shouldPass {
		// Mark data as filtered
		outputData["_filtered"] = true
		outputData["_filter_reason"] = "Conditions not met"
	}

	return outputData, nil
}

func (e *FilterExecutor) evaluateCondition(condition map[string]interface{}, data map[string]interface{}) (bool, error) {
	field := getStringValue(condition, "field")
	operator := getStringValue(condition, "operator")
	value := condition["value"]

	fieldValue := getNestedValue(data, field)

	switch operator {
	case "equals":
		return fmt.Sprintf("%v", fieldValue) == fmt.Sprintf("%v", value), nil

	case "not_equals":
		return fmt.Sprintf("%v", fieldValue) != fmt.Sprintf("%v", value), nil

	case "contains":
		fieldStr := fmt.Sprintf("%v", fieldValue)
		valueStr := fmt.Sprintf("%v", value)
		return strings.Contains(fieldStr, valueStr), nil

	case "greater_than":
		fieldNum := toFloat64(fieldValue)
		valueNum := toFloat64(value)
		return fieldNum > valueNum, nil

	case "less_than":
		fieldNum := toFloat64(fieldValue)
		valueNum := toFloat64(value)
		return fieldNum < valueNum, nil

	case "exists":
		return fieldValue != nil, nil

	case "not_exists":
		return fieldValue == nil, nil

	case "regex_match":
		fieldStr := fmt.Sprintf("%v", fieldValue)
		pattern := fmt.Sprintf("%v", value)
		matched, err := regexp.MatchString(pattern, fieldStr)
		if err != nil {
			return false, fmt.Errorf("invalid regex pattern: %v", err)
		}
		return matched, nil

	case "in_list":
		valueList, ok := value.([]interface{})
		if !ok {
			return false, fmt.Errorf("value must be a list for 'in_list' operator")
		}
		fieldStr := fmt.Sprintf("%v", fieldValue)
		for _, item := range valueList {
			if fmt.Sprintf("%v", item) == fieldStr {
				return true, nil
			}
		}
		return false, nil

	default:
		return false, fmt.Errorf("unsupported operator: %s", operator)
	}
}

func (e *FilterExecutor) GetStepType() string {
	return "filter"
}

func (e *FilterExecutor) Validate(step *models.TransformationStep) error {
	conditions, ok := step.Config["conditions"].([]interface{})
	if !ok || len(conditions) == 0 {
		return fmt.Errorf("at least one condition is required")
	}

	return nil
}
