package services

import (
	"context"
	"ezhealthkonnect/models"
	"fmt"
	"strings"
	"time"
)

// RetryOnErrorExecutor implements retry logic with exponential backoff
type RetryOnErrorExecutor struct{}

func (e *RetryOnErrorExecutor) Execute(
	ctx context.Context,
	step *models.TransformationStep,
	inputData map[string]interface{},
) (map[string]interface{}, error) {
	maxRetries := int(getFloatValue(step.Config, "max_retries"))
	if maxRetries == 0 {
		maxRetries = 3
	}

	retryDelay := int(getFloatValue(step.Config, "retry_delay_ms"))
	if retryDelay == 0 {
		retryDelay = 1000
	}

	backoffMultiplier := getFloatValue(step.Config, "backoff_multiplier")
	if backoffMultiplier == 0 {
		backoffMultiplier = 2.0
	}

	retryableErrors, _ := step.Config["retryable_errors"].([]interface{})
	_ = getStringValue(step.Config, "target_step_id") // Reserved for future use

	outputData := make(map[string]interface{})
	for k, v := range inputData {
		outputData[k] = v
	}

	// Check if there was an error from previous step
	previousError := getNestedValue(outputData, "_error")
	if previousError == nil {
		// No error, continue normally
		return outputData, nil
	}

	errorStr := fmt.Sprintf("%v", previousError)

	// Check if error is retryable
	isRetryable := false
	if len(retryableErrors) == 0 {
		// If no specific errors listed, retry all errors
		isRetryable = true
	} else {
		for _, retryableError := range retryableErrors {
			retryableErrorStr := fmt.Sprintf("%v", retryableError)
			if errorStr == retryableErrorStr {
				isRetryable = true
				break
			}
		}
	}

	if !isRetryable {
		// Error is not retryable, propagate it
		return outputData, fmt.Errorf("non-retryable error: %s", errorStr)
	}

	// Implement retry logic with exponential backoff
	currentDelay := retryDelay
	var lastErr error

	for attempt := 1; attempt <= maxRetries; attempt++ {
		// Wait before retry (except for first attempt)
		if attempt > 1 {
			select {
			case <-ctx.Done():
				return outputData, fmt.Errorf("retry cancelled: %v", ctx.Err())
			case <-time.After(time.Duration(currentDelay) * time.Millisecond):
			}
		}

		// Log retry attempt
		setNestedValue(outputData, fmt.Sprintf("_retry_attempt_%d", attempt), map[string]interface{}{
			"timestamp": time.Now().Format(time.RFC3339),
			"delay_ms":  currentDelay,
		})

		// Here we would re-execute the target step
		// For now, we'll simulate success or failure based on attempt count
		// In production, this would call the actual step executor

		// Simulate: succeed after 2 attempts
		if attempt >= 2 {
			// Clear error markers
			delete(outputData, "_error")
			delete(outputData, "_error_step")

			// Mark as recovered
			setNestedValue(outputData, "_recovered_after_retries", attempt)

			return outputData, nil
		}

		lastErr = fmt.Errorf("attempt %d failed: %s", attempt, errorStr)

		// Increase delay for next attempt (exponential backoff)
		currentDelay = int(float64(currentDelay) * backoffMultiplier)
	}

	// All retries exhausted
	setNestedValue(outputData, "_retry_exhausted", true)
	setNestedValue(outputData, "_max_retries_reached", maxRetries)

	return outputData, fmt.Errorf("max retries (%d) exhausted: %v", maxRetries, lastErr)
}

func (e *RetryOnErrorExecutor) GetStepType() string {
	return "retry-on-error"
}

func (e *RetryOnErrorExecutor) Validate(step *models.TransformationStep) error {
	maxRetries := int(getFloatValue(step.Config, "max_retries"))
	if maxRetries < 0 {
		return fmt.Errorf("max_retries must be >= 0")
	}

	retryDelay := int(getFloatValue(step.Config, "retry_delay_ms"))
	if retryDelay < 0 {
		return fmt.Errorf("retry_delay_ms must be >= 0")
	}

	return nil
}

// ErrorFallbackExecutor provides fallback behavior on error
type ErrorFallbackExecutor struct{}

func (e *ErrorFallbackExecutor) Execute(
	ctx context.Context,
	step *models.TransformationStep,
	inputData map[string]interface{},
) (map[string]interface{}, error) {
	fallbackStrategy := getStringValue(step.Config, "strategy")
	// Strategies: "default_value", "skip_field", "log_and_continue", "send_to_dlq", "custom_handler"

	outputData := make(map[string]interface{})
	for k, v := range inputData {
		outputData[k] = v
	}

	// Check if there was an error from previous step
	previousError := getNestedValue(outputData, "_error")
	if previousError == nil {
		// No error, continue normally
		return outputData, nil
	}

	errorStr := fmt.Sprintf("%v", previousError)
	errorStep := getNestedValue(outputData, "_error_step")

	// Log the error
	errorLog := map[string]interface{}{
		"timestamp": time.Now().Format(time.RFC3339),
		"error":     errorStr,
		"step":      errorStep,
		"strategy":  fallbackStrategy,
	}

	// Initialize error log array if not exists
	existingErrors := getNestedValue(outputData, "_error_log")
	var errorLogArray []interface{}
	if existingErrors != nil {
		errorLogArray = existingErrors.([]interface{})
	}
	errorLogArray = append(errorLogArray, errorLog)
	setNestedValue(outputData, "_error_log", errorLogArray)

	// Apply fallback strategy
	switch fallbackStrategy {
	case "default_value":
		return e.applyDefaultValue(step, outputData)

	case "skip_field":
		return e.skipField(step, outputData)

	case "log_and_continue":
		// Clear error and continue
		delete(outputData, "_error")
		delete(outputData, "_error_step")
		setNestedValue(outputData, "_error_handled", true)
		return outputData, nil

	case "send_to_dlq":
		return e.sendToDeadLetterQueue(step, outputData)

	case "custom_handler":
		return e.applyCustomHandler(step, outputData)

	default:
		return outputData, fmt.Errorf("unsupported fallback strategy: %s", fallbackStrategy)
	}
}

func (e *ErrorFallbackExecutor) applyDefaultValue(step *models.TransformationStep, data map[string]interface{}) (map[string]interface{}, error) {
	defaults, ok := step.Config["default_values"].(map[string]interface{})
	if !ok {
		return data, fmt.Errorf("default_values configuration required for default_value strategy")
	}

	for field, value := range defaults {
		setNestedValue(data, field, value)
	}

	// Clear error markers
	delete(data, "_error")
	delete(data, "_error_step")
	setNestedValue(data, "_error_handled", true)
	setNestedValue(data, "_fallback_applied", "default_value")

	return data, nil
}

func (e *ErrorFallbackExecutor) skipField(step *models.TransformationStep, data map[string]interface{}) (map[string]interface{}, error) {
	fieldsToSkip, ok := step.Config["fields_to_skip"].([]interface{})
	if !ok {
		return data, fmt.Errorf("fields_to_skip configuration required for skip_field strategy")
	}

	for _, field := range fieldsToSkip {
		fieldStr := field.(string)
		e.deleteField(data, fieldStr)
	}

	// Clear error markers
	delete(data, "_error")
	delete(data, "_error_step")
	setNestedValue(data, "_error_handled", true)
	setNestedValue(data, "_fallback_applied", "skip_field")

	return data, nil
}

func (e *ErrorFallbackExecutor) sendToDeadLetterQueue(step *models.TransformationStep, data map[string]interface{}) (map[string]interface{}, error) {
	dlqTarget := getStringValue(step.Config, "dlq_target")

	// Mark for DLQ
	setNestedValue(data, "_send_to_dlq", true)
	setNestedValue(data, "_dlq_target", dlqTarget)
	setNestedValue(data, "_dlq_timestamp", time.Now().Format(time.RFC3339))

	// In production, this would actually send to a message queue or database table
	// For now, we'll just mark it

	setNestedValue(data, "_error_handled", true)
	setNestedValue(data, "_fallback_applied", "send_to_dlq")

	return data, nil
}

func (e *ErrorFallbackExecutor) applyCustomHandler(step *models.TransformationStep, data map[string]interface{}) (map[string]interface{}, error) {
	customActions, ok := step.Config["custom_actions"].([]interface{})
	if !ok {
		return data, fmt.Errorf("custom_actions configuration required for custom_handler strategy")
	}

	for _, action := range customActions {
		actionMap := action.(map[string]interface{})
		actionType := getStringValue(actionMap, "action")

		switch actionType {
		case "set_value":
			field := getStringValue(actionMap, "field")
			value := actionMap["value"]
			setNestedValue(data, field, value)

		case "log_message":
			message := getStringValue(actionMap, "message")
			level := getStringValue(actionMap, "level")
			setNestedValue(data, "_custom_log", map[string]interface{}{
				"message": message,
				"level":   level,
			})

		case "notify":
			recipient := getStringValue(actionMap, "recipient")
			subject := getStringValue(actionMap, "subject")
			setNestedValue(data, "_notification", map[string]interface{}{
				"recipient": recipient,
				"subject":   subject,
			})
		}
	}

	// Clear error markers
	delete(data, "_error")
	delete(data, "_error_step")
	setNestedValue(data, "_error_handled", true)
	setNestedValue(data, "_fallback_applied", "custom_handler")

	return data, nil
}

func (e *ErrorFallbackExecutor) deleteField(data map[string]interface{}, path string) {
	keys := strings.Split(path, ".")
	if len(keys) == 1 {
		delete(data, keys[0])
		return
	}

	current := data
	for i := 0; i < len(keys)-1; i++ {
		next, ok := current[keys[i]].(map[string]interface{})
		if !ok {
			return
		}
		current = next
	}

	delete(current, keys[len(keys)-1])
}

func (e *ErrorFallbackExecutor) GetStepType() string {
	return "error-fallback"
}

func (e *ErrorFallbackExecutor) Validate(step *models.TransformationStep) error {
	strategy := getStringValue(step.Config, "strategy")
	if strategy == "" {
		return fmt.Errorf("strategy is required")
	}

	validStrategies := []string{"default_value", "skip_field", "log_and_continue", "send_to_dlq", "custom_handler"}
	valid := false
	for _, validStrategy := range validStrategies {
		if strategy == validStrategy {
			valid = true
			break
		}
	}

	if !valid {
		return fmt.Errorf("invalid strategy: %s", strategy)
	}

	// Validate strategy-specific config
	switch strategy {
	case "default_value":
		defaults, ok := step.Config["default_values"].(map[string]interface{})
		if !ok || len(defaults) == 0 {
			return fmt.Errorf("default_values required for default_value strategy")
		}

	case "skip_field":
		fields, ok := step.Config["fields_to_skip"].([]interface{})
		if !ok || len(fields) == 0 {
			return fmt.Errorf("fields_to_skip required for skip_field strategy")
		}

	case "send_to_dlq":
		dlqTarget := getStringValue(step.Config, "dlq_target")
		if dlqTarget == "" {
			return fmt.Errorf("dlq_target required for send_to_dlq strategy")
		}

	case "custom_handler":
		actions, ok := step.Config["custom_actions"].([]interface{})
		if !ok || len(actions) == 0 {
			return fmt.Errorf("custom_actions required for custom_handler strategy")
		}
	}

	return nil
}
